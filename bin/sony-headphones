# ---------------------------------------------------------------------------
# Framing
# ---------------------------------------------------------------------------
#
# <0x3e> ESCAPE(<type><seq><len:4 BE><payload><checksum>) <0x3c>
#
# The checksum is a plain byte sum of everything from <type> through the last
# payload byte. Escaping happens after the checksum is appended, so a checksum
# that lands on a marker byte gets escaped too.

HEADER = 0x3E
TRAILER = 0x3C
ESCAPE = 0x3D
ESCAPE_MASK = 0xEF

MSG_ACK = 0x01
MSG_COMMAND_1 = 0x0C
MSG_COMMAND_2 = 0x0E

MAX_MESSAGE_SIZE = 2048

# Sony's app SPP service. Used to recognise a device that speaks this protocol.
# v1 (WH-1000XM2/XM3/XM4) advertises the first UUID; the v2 generation
# (WH-1000XM5/XM6, WF-1000XM5, LinkBuds, CH720N…) advertises the second, which
# the older models do not. Either one identifies a device this helper can ask
# for a control channel; the init handshake then says which command set it speaks.
SERVICE_UUID = "96cc203e-5068-46ad-b32d-e316f5e069ba"
SERVICE_UUID_V2 = "956c7b26-d49a-4ba8-b03f-b17d393cb6e2"


class ProtocolError(Exception):
    """A frame that arrived malformed. Recoverable: drop it and read on."""


def escape(data: bytes) -> bytes:
    out = bytearray()
    for b in data:
        if b in (HEADER, TRAILER, ESCAPE):
            out.append(ESCAPE)
            out.append(b & ESCAPE_MASK)
        else:
            out.append(b)
    return bytes(out)


def unescape(data: bytes) -> bytes:
    out = bytearray()
    i = 0
    while i < len(data):
        b = data[i]
        if b == ESCAPE:
            i += 1
            if i >= len(data):
                raise ProtocolError("escape character at end of frame")
            out.append(data[i] | (~ESCAPE_MASK & 0xFF))
        else:
            out.append(b)
        i += 1
    return bytes(out)


def checksum(data: bytes) -> int:
    return sum(data) & 0xFF


def encode_message(msg_type: int, seq: int, payload: bytes) -> bytes:
    body = bytes([msg_type, seq]) + len(payload).to_bytes(4, "big") + payload
    frame = bytes([HEADER]) + escape(body + bytes([checksum(body)])) + bytes([TRAILER])
    if len(frame) > MAX_MESSAGE_SIZE:
        raise ProtocolError("message exceeds the maximum bluetooth message size")
    return frame


def decode_message(frame: bytes) -> tuple[int, int, bytes]:
    """Take a raw frame including markers, return (type, seq, payload)."""
    if not frame or frame[0] != HEADER or frame[-1] != TRAILER:
        raise ProtocolError("frame is missing its markers")

    body = unescape(frame[1:-1])
    if len(body) < 7:
        raise ProtocolError("frame is shorter than the minimum message size")

    expected = checksum(body[:-1])
    if body[-1] != expected:
        raise ProtocolError(f"bad checksum {body[-1]:02x}, expected {expected:02x}")

    length = int.from_bytes(body[2:6], "big")
    payload = body[6:-1]
    if length != len(payload):
        raise ProtocolError(f"declared length {length} but got {len(payload)} bytes")

    return body[0], body[1], payload


# ---------------------------------------------------------------------------
# Frame trace
# ---------------------------------------------------------------------------
#
# A byte-level trace is the only practical view of a conversation that is
# otherwise invisible: the helper speaks RFCOMM directly, and a checksum the
# device rejects or a sequence number it ignores leaves no other mark. Tracing
# is off unless SONY_HEADPHONES_TRACE asks for it, so an ordinary run pays
# nothing for the facility.
#
# The split between stderr and a file is deliberate rather than a convenience.
# The browser widget parses its helper's stderr as an error message, so a
# daemon that traced there would be reported as broken every time it sent a
# frame; a daemon therefore has to be pointed at a file path. The CLI, whose
# stderr is read by a human, can simply pass 1. Any other value is taken as a
# file path and opened in append mode; if it cannot be opened, tracing falls
# back to disabled rather than turning a debugging aid into a new failure.


def _open_trace_file(path):
    """Open `path` as an append-only trace file private to this user, or None.

    The trace path arrives from the environment, and the ordinary open() that
    used to be here would follow a symlink parked on it and keep whatever mode
    the target already had: an arbitrary-file-append primitive. It was
    replaced with the same hardened open the lock and the log use, O_NOFOLLOW
    with mode 0600, followed by an fstat that proves the inode is a regular
    file owned by this user before a byte is written. Any failure returns None
    and leaves tracing off, because a debugging aid must never become the
    failure being debugged.
    """
    try:
        fd = os.open(
            path,
            os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
        )
    except (OSError, ValueError):
        return None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise OSError(f"{path} is not a trace file owned by this user")
        os.fchmod(fd, 0o600)
        return os.fdopen(fd, "a", buffering=1)
    except (OSError, ValueError):
        os.close(fd)
        return None


_TRACE_FILE = None
try:
    _trace_setting = os.environ.get("SONY_HEADPHONES_TRACE", "")
    if _trace_setting == "1":
        _TRACE_FILE = sys.stderr
    elif _trace_setting not in ("", "0"):
        _TRACE_FILE = _open_trace_file(_trace_setting)
except (OSError, ValueError):
    _TRACE_FILE = None

# The timestamp each line is measured against, so the delta shows the time
# between frames rather than time since the process started.
_trace_last = time.monotonic()


def trace(direction: str, raw: bytes, decoded=None, note: str = "") -> None:
    """Write one frame trace line, or nothing at all when tracing is off.

    Never raises and never writes to stdout: the shell parses stdout as JSON,
    so a failure in the trace must not disturb the conversation it observes.
    A decodable frame renders as type, sequence, opcode and payload; anything
    else falls back to the supplied note, or to `undecodable`.
    """
    global _trace_last
    if _TRACE_FILE is None:
        return
    try:
        now = time.monotonic()
        delta = now - _trace_last
        _trace_last = now
        if decoded is not None:
            msg_type, seq, payload = decoded
            opcode = f"0x{payload[0]:02x}" if payload else "0x--"
            detail = f"type={msg_type} seq={seq} opcode={opcode} payload={payload.hex()}"
        else:
            detail = note or "undecodable"
        _TRACE_FILE.write(f"{delta:.3f} {direction} {raw.hex()} {detail}\n")
        _TRACE_FILE.flush()
    except Exception:
        pass


