# ---------------------------------------------------------------------------
# Payload opcodes (protocol v2: WH-1000XM5/XM6, WF-1000XM5, LinkBuds, CH720N…)
# ---------------------------------------------------------------------------
#
# Same framing and ACK discipline as v1, a different command set. Several
# numeric opcodes are reused across unrelated features in v2 and told apart by
# a subtype byte at payload[1], so the constants here name the family and the
# subtypes sit beside the builders below. Payload layouts follow Gadgetbridge's
# v2 protocol implementation and were confirmed against a WH-1000XM6 by probing
# each request and reading the reply.
V2_INIT_REQUEST = 0x00
V2_INIT_REPLY = 0x01

# Codec readout uses its own opcode here, different from v1's CODEC_GET family,
# but the code byte carries the same meaning and is decoded through the shared
# AUDIO_CODECS table below.
V2_AUDIO_CODEC_GET = 0x12
V2_AUDIO_CODEC_RET = 0x13
V2_AUDIO_CODEC_NOTIFY = 0x15

# A second audio family carries DSEE Extreme and the Bluetooth connection
# quality, told apart by payload[1]: subtype 0x01 is DSEE Extreme and 0x02 is
# connection quality. Connection quality is inverted on the wire — 0x00 asks
# for sound quality (LDAC) and 0x01 for a stable connection (SBC). On v1 the
# same two features use the opposite subtype split, which is why neither is
# routed through BOOL_SETTINGS below.
V2_AUDIO_GET = 0xE6
V2_AUDIO_RET = 0xE7
V2_AUDIO_SET = 0xE8
V2_AUDIO_NOTIFY = 0xE9
V2_AUDIO_SUB_DSEE = 0x01
V2_AUDIO_SUB_CONNECTION_QUALITY = 0x02
V2_CONNECTION_QUALITY_SOUND = 0x00
V2_CONNECTION_QUALITY_STABLE = 0x01

# The XM6's "listening mode" (standard / background music / cinema) also rides
# this family, but it is not one value on the wire: Upmix Cinema and Background
# Music are two independent on/off flags with their own subtypes, and the mode
# the vendor app shows is derived from them with background music taking
# priority. Both flags are inverted, so 0x00 means on. Background Music carries
# a room byte as well, and some firmware answers or sets it under subtype 0x03
# rather than 0x09.
V2_AUDIO_SUB_UPMIX_CINEMA = 0x04
V2_AUDIO_SUB_BGM = 0x09
V2_AUDIO_SUB_BGM_ALT = 0x03
V2_BGM_ROOM = {"my-room": 0x00, "living-room": 0x01, "cafe": 0x02}
V2_BGM_ROOM_FROM_CODE = {v: k for k, v in V2_BGM_ROOM.items()}
# A write to one of these that takes the whole link down with it is the
# signature of a digital assistant blocking Background music: Sound Connect
# greys the feature out while one is set ("check Voice control / Voice
# assistant"), and the device resets when the write goes out anyway. Keeping
# the keys listed lets a lost link carry that explanation instead of a bare
# connection error.
BGM_WRITE_KEYS = frozenset({"listening-mode", "bgm-room-size"})
BGM_RESET_REASON = (
    "the headphones reset during the write; a digital assistant may be set — "
    "check Voice control / Voice assistant in Sound Connect"
)

V2_BATTERY_GET = 0x22
V2_BATTERY_RET = 0x23
V2_BATTERY_NOTIFY = 0x25
V2_BATTERY_SINGLE = 0x00

V2_EQ_GET = 0x56
V2_EQ_RET = 0x57
V2_EQ_SET = 0x58
V2_EQ_NOTIFY = 0x59
# The XM6 answers subtype 0x04; 0x00 is the XM5-style dialect.
V2_EQ_SUBTYPE_DEFAULT = 0x04

V2_ASC_GET = 0x66
V2_ASC_RET = 0x67
V2_ASC_SET = 0x68
V2_ASC_NOTIFY = 0x69

# POWER family: automatic power off duration (subtype 0x05).
V2_APO_GET = 0x26
V2_APO_RET = 0x27
V2_APO_SET = 0x28
V2_APO_NOTIFY = 0x29
V2_APO_SUB_AUTO_POWER_OFF = 0x05

# SYSTEM family: pause-when-taken-off (subtype 0x01) and speak-to-chat on/off
# (subtype 0x0c). GET and SET share the family here, unlike v1.
V2_SYSTEM_GET = 0xF6
V2_SYSTEM_RET = 0xF7
V2_SYSTEM_SET = 0xF8
V2_SYSTEM_NOTIFY = 0xF9
V2_SYSTEM_SUB_PAUSE_WHEN_TAKEN_OFF = 0x01
V2_SYSTEM_SUB_SPEAK_TO_CHAT = 0x0C

# Speak-to-chat configuration (sensitivity, resume timeout) rides its own family.
V2_STC_CONFIG_GET = 0xFA
V2_STC_CONFIG_RET = 0xFB
V2_STC_CONFIG_SET = 0xFC
V2_STC_CONFIG_NOTIFY = 0xFD
V2_STC_CONFIG_SUB = 0x0C

# PERIPHERAL family, which rides message table 2 rather than table 1: the
# XM6 lists its Bluetooth multipoint peers and switches which one plays audio
# through this family, told apart by a subtype byte at payload[1]. The device
# list is asked for with subtype 0x02 and answered/announced under 0x37/0x39;
# 0x3C with subtype 0x01 carries the MAC of the peer to make the playback
# source. Unlike the rest of v2, these frames are MSG_COMMAND_2.
V2_PERI_GET = 0x36
V2_PERI_RET = 0x37
V2_PERI_NOTIFY = 0x39
V2_PERI_SET_EXTENDED = 0x3C
V2_PERI_SUB_DEVICE_LIST = 0x02
V2_PERI_SUB_SOURCE_SWITCH = 0x01

# Ambient sound control subtypes. The device answers whichever dialect its
# firmware speaks, and writes echo that subtype back rather than assuming one.
# 0x19 is the current over-ear generation's "noise adaptation" parameter (the
# XM5/XM6 advertise support function 0x6d for it); 0x17 and 0x15 are the older
# shapes, and V2_ASC_SUBTYPE_AMBIENT is ambient-only. The subtype is chosen by
# asking, since a device that supports 0x19 still answers 0x17 out of a dormant
# legacy slot.
V2_ASC_SUBTYPE_QUERY = 0x19
V2_ASC_SUBTYPE_NA = 0x19
V2_ASC_SUBTYPE_WIND = 0x15
V2_ASC_SUBTYPE_AMBIENT = 0x22

# Membership only: which subtypes the parser accepts, in no meaningful order.
V2_ASC_SUBTYPES = (V2_ASC_SUBTYPE_WIND, 0x17, V2_ASC_SUBTYPE_QUERY, V2_ASC_SUBTYPE_AMBIENT)

# The order the handshake tries the dialects in: the query subtype first, then
# the older shapes in the order they have always been tried. A separate tuple so
# the membership constant above never doubles as a probe order.
V2_ASC_PROBE_ORDER = (V2_ASC_SUBTYPE_QUERY, 0x17, V2_ASC_SUBTYPE_WIND, V2_ASC_SUBTYPE_AMBIENT)

# The v2 generation dropped the classic preset table: firmware accepts only
# these codes, plus Custom. The set is confirmed on the WH-1000XM6 by probing
# each code and reading the reply; the other v2 models are offered the same
# table unverified, and a code one refuses surfaces as a refused row rather
# than a silent no-op. The ten-band curve uses a symmetric gain range stored
# biased by six.
V2_EQ_PRESETS = {
    "off": 0x00,
    "heavy": 0x30,
    "clear": 0x31,
    "hard": 0x32,
    "soft": 0x33,
    "custom": 0xA0,
}
V2_EQ_PRESET_FROM_CODE = {v: k for k, v in V2_EQ_PRESETS.items()}
V2_EQ_BAND_COUNT = 10
V2_EQ_BAND_OFFSET = 6
V2_EQ_BAND_MIN = -6
V2_EQ_BAND_MAX = 6

# v2 accepts exactly two automatic-power-off values; the timed options of the
# older models are rejected on-device.
V2_AUTO_POWER_OFF = {"when-taken-off": 0x10, "off": 0x11}
V2_AUTO_POWER_OFF_FROM_CODE = {v: k for k, v in V2_AUTO_POWER_OFF.items()}

NC_MODES = ("off", "noise-cancelling", "wind-noise-reduction", "ambient-sound")
ASC_MODE_CODE = {"ambient-sound": 0x00, "wind-noise-reduction": 0x01, "noise-cancelling": 0x02}
ASC_MODE_FROM_CODE = {v: k for k, v in ASC_MODE_CODE.items()}
# Without wind noise reduction the mode byte only distinguishes ambient from NC.
ASC_MODE_CODE_NO_WIND = {"ambient-sound": 0x00, "noise-cancelling": 0x01}
ASC_MODE_FROM_CODE_NO_WIND = {v: k for k, v in ASC_MODE_CODE_NO_WIND.items()}

MAX_AMBIENT_LEVEL = 20

EQ_PRESETS = {
    "off": 0x00,
    "bright": 0x10,
    "excited": 0x11,
    "mellow": 0x12,
    "relaxed": 0x13,
    "vocal": 0x14,
    "treble-boost": 0x15,
    "bass-boost": 0x16,
    "speech": 0x17,
    "manual": 0xA0,
    "custom-1": 0xA1,
    "custom-2": 0xA2,
}
EQ_PRESET_FROM_CODE = {v: k for k, v in EQ_PRESETS.items()}

AUTO_POWER_OFF = {
    "off": (0x11, 0x00),
    "5-min": (0x00, 0x00),
    "30-min": (0x01, 0x01),
    "1-hour": (0x02, 0x02),
    "3-hour": (0x03, 0x03),
    "when-taken-off": (0x10, 0x00),
}
AUTO_POWER_OFF_FROM_CODE = {v: k for k, v in AUTO_POWER_OFF.items()}

STC_SENSITIVITY = {"auto": 0x00, "high": 0x01, "low": 0x02}
STC_SENSITIVITY_FROM_CODE = {v: k for k, v in STC_SENSITIVITY.items()}
STC_TIMEOUT = {"short": 0x00, "standard": 0x01, "long": 0x02, "off": 0x03}
STC_TIMEOUT_FROM_CODE = {v: k for k, v in STC_TIMEOUT.items()}

AUDIO_CODECS = {0x00: "unknown", 0x01: "SBC", 0x02: "AAC", 0x10: "LDAC", 0x20: "aptX", 0x21: "aptX HD"}

# The ceiling of each protocol's command set: every control a device speaking
# that protocol can carry. A per-model set below is a refinement of one of
# these, never a mix of the two generations.
V1_FEATURES = {
    "battery", "equalizer", "dsee", "speak-to-chat", "speak-to-chat-focus",
    "pause-when-taken-off", "voice-notifications", "auto-power-off",
    "auto-power-off-timer", "touch-sensor", "nc-optimizer",
}
V2_FEATURES = {
    "battery", "equalizer", "dsee", "connection-quality", "speak-to-chat",
    "pause-when-taken-off", "voice-notifications", "auto-power-off", "listening-mode", "multipoint",
}
FEATURE_CEILINGS = {"v1": V1_FEATURES, "v2": V2_FEATURES}

# Presentation-only markers: feature strings that gate a row's availability in
# the panel, not a wire command. They ride in FEATURE_SETS (and therefore in
# state["features"]) so Model.availabilityFor can read them, but they are
# exempt from the generation-ceiling check below.
UI_FEATURES = {"eq-sbc-only"}

# What each model actually honours, verified against hardware where the status
# says so and taken from Gadgetbridge's device coordinators otherwise. Sending a
# command a model ignores is harmless but leaves a dead control on screen, which
# is worse than not offering it: a WH-1000XM4 answers "still on" to every
# attempt at disabling its touch panel, and answers "when taken off" to every
# auto-power-off timer.
FEATURE_SETS = {
    "v1": {
        "WH-1000XM4": {
            "battery", "equalizer", "dsee", "speak-to-chat", "speak-to-chat-focus",
            "pause-when-taken-off", "voice-notifications", "auto-power-off", "nc-optimizer",
        },
        "WH-1000XM3": {
            "battery", "equalizer", "dsee", "touch-sensor", "voice-notifications",
            "auto-power-off", "auto-power-off-timer", "nc-optimizer", "eq-sbc-only",
        },
        "WH-1000XM2": {
            "battery", "equalizer", "dsee", "nc-optimizer", "eq-sbc-only",
        },
    },
    # The v2 generation: no touch panel or NC optimizer in this command
    # set, and speak-to-chat carries no voice-focus option. Voice guidance
    # (voice-notifications) is confirmed on the WH-1000XM6 (firmware 3.1.5
    # answers the v1-shaped GET `46 01 01` with `47 01 00 03`) and on the
    # WH-1000XM5 by capture; the remaining v2 models stay without it until
    # hardware or a capture says otherwise.
    "v2": {
        "WH-1000XM6": {
            "battery", "equalizer", "dsee", "connection-quality", "speak-to-chat",
            "pause-when-taken-off", "voice-notifications", "auto-power-off",
            "listening-mode", "multipoint",
        },
        "WH-1000XM5": {
            "battery", "equalizer", "dsee", "connection-quality", "speak-to-chat",
            "pause-when-taken-off", "voice-notifications", "auto-power-off",
        },
        "WF-1000XM5": {
            "battery", "equalizer", "dsee", "connection-quality", "speak-to-chat",
            "pause-when-taken-off", "auto-power-off",
        },
        # "LinkBuds" is a substring of "LinkBuds S" and features_for matches by
        # case-insensitive substring in dict order, so the longer name must come
        # first or every LinkBuds S would resolve to the open-LinkBuds entry.
        "LinkBuds S": {
            "battery", "equalizer", "dsee", "speak-to-chat",
            "pause-when-taken-off", "auto-power-off",
        },
        "LinkBuds": {
            "battery", "equalizer", "dsee", "speak-to-chat",
            "pause-when-taken-off", "auto-power-off",
        },
        "WH-CH720N": {
            "battery", "equalizer", "dsee", "connection-quality", "auto-power-off",
        },
    },
}

# A model set that strays outside its own generation is a bug, and it should
# fail here at import rather than by writing an opcode the device cannot route.
for _protocol, _models in FEATURE_SETS.items():
    for _model, _model_features in _models.items():
        _outside = _model_features - FEATURE_CEILINGS[_protocol] - UI_FEATURES
        if _outside:
            raise RuntimeError(
                f"{_model} claims {sorted(_outside)} outside the {_protocol} command set"
            )

# An unrecognised device gets everything its own protocol can carry; only with
# no protocol at all is the union offered, because then there is nothing to
# choose between the two generations.
ALL_FEATURES = V1_FEATURES | V2_FEATURES


def features_for(name: str | None, protocol: str | None = None) -> list:
    """The controls a device should be offered.

    A recognised model gets its own set. When the protocol is known the search
    stays inside that generation's models, so a name can never pull the other
    generation's controls in. An unrecognised device gets the whole ceiling of
    its protocol: the confirmed init handshake once there is one, the
    bluetoothctl hint before that. Only with neither is the union offered,
    since the name alone cannot say what the device speaks.
    """
    if protocol in FEATURE_SETS:
        candidates = FEATURE_SETS[protocol]
    else:
        candidates = {
            model: features
            for models in FEATURE_SETS.values()
            for model, features in models.items()
        }
    text = str(name or "").lower()
    for model, features in candidates.items():
        if model.lower() in text:
            return sorted(features)
    if protocol in FEATURE_CEILINGS:
        return sorted(FEATURE_CEILINGS[protocol])
    return sorted(ALL_FEATURES)


BATTERY_SINGLE = 0x00
BATTERY_CASE = 0x02


# ---------------------------------------------------------------------------
# Requests
# ---------------------------------------------------------------------------


def req(payload: bytes, msg_type: int = MSG_COMMAND_1) -> tuple[int, bytes]:
    return msg_type, payload


def refresh_requests() -> list[tuple[int, bytes]]:
    """Everything worth asking for after a connect, in display order."""
    return [
        req(bytes([FW_VERSION_REQUEST, 0x02])),
        req(bytes([CODEC_GET, 0x00])),
        req(bytes([BATTERY_GET, BATTERY_SINGLE])),
        req(bytes([ASC_GET, 0x02])),
        req(bytes([EQUALIZER_GET, 0x01])),
        req(bytes([UPSAMPLING_GET, 0x02])),
        req(bytes([APO_GET, APO_SUB_SPEAK_TO_CHAT])),
        req(bytes([STC_CONFIG_GET, 0x05])),
        req(bytes([APO_GET, APO_SUB_PAUSE_WHEN_TAKEN_OFF])),
        req(bytes([APO_GET, APO_SUB_AUTO_POWER_OFF])),
        req(bytes([TOUCH_GET, 0xD2])),
        req(bytes([NC_OPTIMIZER_STATE_GET, 0x01])),
        req(bytes([VOICE_NOTIFICATIONS_GET, 0x01, 0x01]), MSG_COMMAND_2),
    ]


def finite_int(value) -> int:
    """Convert a setting value to int, refusing a non-finite number.

    JSON's parser accepts `Infinity` and `NaN`, and `int(float("inf"))` raises
    `OverflowError` -- an `ArithmeticError`, not the `ValueError` the command
    boundary promises -- so the refusal lives here, where the value stops being
    a plain number.
    """
    if isinstance(value, float) and not math.isfinite(value):
        raise ValueError(f"expected a finite number, got {value!r}")
    return int(value)


def asc_request(mode: str, level: int, focus_on_voice: bool, supports_wind: bool) -> tuple[int, bytes]:
    """Ambient sound control. One command carries mode, level and voice focus."""
    if mode not in NC_MODES:
        raise ValueError(f"unknown mode {mode!r}; expected one of {', '.join(NC_MODES)}")
    if mode == "wind-noise-reduction" and not supports_wind:
        raise ValueError("this device does not support wind noise reduction")

    level = max(0, min(MAX_AMBIENT_LEVEL, finite_int(level)))

    payload = bytearray([ASC_SET, 0x02])
    payload.append(0x00 if mode == "off" else 0x11)

    if supports_wind:
        payload.append(0x02)
        payload.append(ASC_MODE_CODE.get(mode, 0x00))
    else:
        payload.append(0x00)
        payload.append(ASC_MODE_CODE_NO_WIND.get(mode, 0x00))

    payload.append(0x01)
    payload.append(0x01 if focus_on_voice else 0x00)
    # The level byte only carries meaning in ambient mode; NC reports zero.
    payload.append(level if mode in ("off", "ambient-sound") else 0x00)

    return req(bytes(payload))


def eq_preset_request(preset: str) -> tuple[int, bytes]:
    if preset not in EQ_PRESETS:
        raise ValueError(f"unknown equalizer preset {preset!r}")
    return req(bytes([EQUALIZER_SET, 0x01, EQ_PRESETS[preset], 0x00]))


def eq_bands_request(bass: int, bands: list[int]) -> tuple[int, bytes]:
    if len(bands) != 5:
        raise ValueError("expected 5 equalizer bands")
    values = [bass] + list(bands)
    for value in values:
        if value < -10 or value > 10:
            raise ValueError("equalizer values must be between -10 and 10")
    return req(bytes([EQUALIZER_SET, 0x01, 0xFF, 0x06] + [v + 10 for v in values]))


def bool_request(opcode: int, sub: int, spacer: int, enabled: bool) -> tuple[int, bytes]:
    return req(bytes([opcode, sub, spacer, 0x01 if enabled else 0x00]))


def auto_power_off_request(value: str) -> tuple[int, bytes]:
    if value not in AUTO_POWER_OFF:
        raise ValueError(f"unknown auto power off value {value!r}")
    c0, c1 = AUTO_POWER_OFF[value]
    return req(bytes([APO_SET, APO_SUB_AUTO_POWER_OFF, 0x01, c0, c1]))


def stc_config_request(sensitivity: str, focus_on_voice: bool, timeout: str) -> tuple[int, bytes]:
    if sensitivity not in STC_SENSITIVITY:
        raise ValueError(f"unknown speak-to-chat sensitivity {sensitivity!r}")
    if timeout not in STC_TIMEOUT:
        raise ValueError(f"unknown speak-to-chat timeout {timeout!r}")
    return req(bytes([
        STC_CONFIG_SET,
        0x05,
        0x00,
        STC_SENSITIVITY[sensitivity],
        0x01 if focus_on_voice else 0x00,
        STC_TIMEOUT[timeout],
    ]))


# -- protocol v2 requests ---------------------------------------------------


def v2_audio_codec_get() -> tuple[int, bytes]:
    # Subtype 0x02 selects the codec parameter inside the audio family.
    return req(bytes([V2_AUDIO_CODEC_GET, 0x02]))


def v2_dsee_get() -> tuple[int, bytes]:
    return req(bytes([V2_AUDIO_GET, V2_AUDIO_SUB_DSEE]))


def v2_dsee_request(enabled: bool) -> tuple[int, bytes]:
    return req(bytes([V2_AUDIO_SET, V2_AUDIO_SUB_DSEE, 0x01 if enabled else 0x00]))


def v2_connection_quality_get() -> tuple[int, bytes]:
    return req(bytes([V2_AUDIO_GET, V2_AUDIO_SUB_CONNECTION_QUALITY]))


def v2_connection_quality_request(value: str) -> tuple[int, bytes]:
    # The shared audio family splits DSEE Extreme (subtype 0x01) from connection
    # quality (subtype 0x02), and connection quality is inverted: 0x00 is sound
    # quality (LDAC) and 0x01 is a stable connection (SBC). v1 swaps these two
    # subtypes, so BOOL_SETTINGS["dsee"] cannot be reused here.
    if value not in ("sound-quality", "stable"):
        raise ValueError(f"unknown connection quality {value!r}")
    code = V2_CONNECTION_QUALITY_SOUND if value == "sound-quality" else V2_CONNECTION_QUALITY_STABLE
    return req(bytes([V2_AUDIO_SET, V2_AUDIO_SUB_CONNECTION_QUALITY, code]))


def v2_cinema_get() -> tuple[int, bytes]:
    return req(bytes([V2_AUDIO_GET, V2_AUDIO_SUB_UPMIX_CINEMA]))


def v2_cinema_request(enabled: bool) -> tuple[int, bytes]:
    # Inverted on the wire, like the rest of this family: 0x00 turns it on.
    return req(bytes([V2_AUDIO_SET, V2_AUDIO_SUB_UPMIX_CINEMA, 0x00 if enabled else 0x01]))


def v2_bgm_get(subtype: int = V2_AUDIO_SUB_BGM) -> tuple[int, bytes]:
    return req(bytes([V2_AUDIO_GET, subtype]))


def v2_bgm_request(enabled: bool, room_size: str,
                   subtype: int = V2_AUDIO_SUB_BGM) -> tuple[int, bytes]:
    # Background Music and Upmix Cinema are two independent flags on the wire,
    # not one mode value: the app derives standard/background-music/cinema from
    # them, giving background music priority. Both are inverted, so 0x00 is on.
    # Background Music also carries the room being simulated, and some firmware
    # uses subtype 0x03 rather than 0x09, so the device's own subtype is echoed.
    if room_size not in V2_BGM_ROOM:
        raise ValueError(
            f"unknown room size {room_size!r}; expected one of {', '.join(V2_BGM_ROOM)}"
        )
    return req(bytes([
        V2_AUDIO_SET,
        subtype,
        0x00 if enabled else 0x01,
        V2_BGM_ROOM[room_size],
    ]))


def v2_asc_request(mode: str, level: int, focus_on_voice: bool,
                   subtype: int = V2_ASC_SUBTYPE_QUERY,
                   auto_ambient: int = 0x00, noise_adapt_sensitivity: int = 0x00):
    """Ambient sound control. Mode, level and voice focus in one command.

    Each subtype carries the same core bytes in the same order and differs in
    what follows: 0x19 appends the noise-adaptation fields, 0x15 inserts a wind
    byte, and 0x22 is ambient-only. The device's own subtype is echoed back so
    we always speak whichever dialect it answered under.
    """
    if mode not in NC_MODES:
        raise ValueError(f"unknown mode {mode!r}; expected one of {', '.join(NC_MODES)}")
    if mode == "wind-noise-reduction" and subtype != V2_ASC_SUBTYPE_WIND:
        raise ValueError("this device does not support wind noise reduction")

    level = max(0, min(MAX_AMBIENT_LEVEL, finite_int(level)))
    # Ambient at zero is "off" with extra steps; the vendor app never sends it.
    if mode == "ambient-sound" and level == 0:
        level = 1
    on_off = 0x00 if mode == "off" else 0x01
    ambient = 0x01 if mode == "ambient-sound" else 0x00
    focus = 0x01 if focus_on_voice else 0x00

    if subtype == V2_ASC_SUBTYPE_NA:
        payload = [
            V2_ASC_SET, subtype, 0x01, on_off, ambient, focus, level,
            auto_ambient & 0x01, noise_adapt_sensitivity,
        ]
    elif subtype == V2_ASC_SUBTYPE_WIND:
        payload = [
            V2_ASC_SET, subtype, 0x01, on_off, ambient,
            0x03 if mode == "wind-noise-reduction" else 0x02, focus, level,
        ]
    elif subtype == V2_ASC_SUBTYPE_AMBIENT:
        payload = [V2_ASC_SET, subtype, 0x01, on_off, 0x01, focus, level]
    else:
        payload = [V2_ASC_SET, subtype, 0x01, on_off, ambient, focus, level]
    return req(bytes(payload))


def v2_asc_get(subtype: int = V2_ASC_SUBTYPE_QUERY) -> tuple[int, bytes]:
    return req(bytes([V2_ASC_GET, subtype]))


def v2_eq_get(subtype: int = V2_EQ_SUBTYPE_DEFAULT) -> tuple[int, bytes]:
    return req(bytes([V2_EQ_GET, subtype]))


def v2_eq_preset_request(preset: str, subtype: int = V2_EQ_SUBTYPE_DEFAULT) -> tuple[int, bytes]:
    if preset not in V2_EQ_PRESETS:
        raise ValueError(f"unknown equalizer preset {preset!r}")
    return req(bytes([V2_EQ_SET, subtype, V2_EQ_PRESETS[preset], 0x00]))


def v2_eq_bands_request(bands: list[int], subtype: int = V2_EQ_SUBTYPE_DEFAULT) -> tuple[int, bytes]:
    if len(bands) != V2_EQ_BAND_COUNT:
        raise ValueError(f"expected {V2_EQ_BAND_COUNT} equalizer bands")
    for value in bands:
        if value < V2_EQ_BAND_MIN or value > V2_EQ_BAND_MAX:
            raise ValueError(
                f"equalizer values must be between {V2_EQ_BAND_MIN} and {V2_EQ_BAND_MAX}"
            )
    return req(bytes(
        [V2_EQ_SET, subtype, V2_EQ_PRESETS["custom"], V2_EQ_BAND_COUNT]
        + [v + V2_EQ_BAND_OFFSET for v in bands]
    ))


def v2_system_get(sub: int) -> tuple[int, bytes]:
    return req(bytes([V2_SYSTEM_GET, sub]))


def v2_stc_enabled_request(enabled: bool) -> tuple[int, bytes]:
    # Inverted on v2: 0x00 enables.
    return req(bytes([V2_SYSTEM_SET, V2_SYSTEM_SUB_SPEAK_TO_CHAT,
                      0x00 if enabled else 0x01, 0x01]))


def v2_bool_request(opcode: int, sub: int, enabled: bool) -> tuple[int, bytes]:
    return req(bytes([opcode, sub, 0x00 if enabled else 0x01]))


def v2_stc_config_request(sensitivity: str, timeout: str) -> tuple[int, bytes]:
    if sensitivity not in STC_SENSITIVITY:
        raise ValueError(f"unknown speak-to-chat sensitivity {sensitivity!r}")
    if timeout not in STC_TIMEOUT:
        raise ValueError(f"unknown speak-to-chat timeout {timeout!r}")
    return req(bytes([
        V2_STC_CONFIG_SET,
        V2_STC_CONFIG_SUB,
        STC_SENSITIVITY[sensitivity],
        STC_TIMEOUT[timeout],
    ]))


def v2_auto_power_off_request(value: str) -> tuple[int, bytes]:
    if value not in V2_AUTO_POWER_OFF:
        raise ValueError(
            f"unknown auto power off value {value!r}; expected 'off' or 'when-taken-off'"
        )
    return req(bytes([V2_APO_SET, V2_APO_SUB_AUTO_POWER_OFF, V2_AUTO_POWER_OFF[value], 0x00]))


def v2_stc_get() -> tuple[int, bytes]:
    return req(bytes([V2_STC_CONFIG_GET, V2_STC_CONFIG_SUB]))


def v2_apo_get() -> tuple[int, bytes]:
    return req(bytes([V2_APO_GET, V2_APO_SUB_AUTO_POWER_OFF]))


def v2_device_list_get() -> tuple[int, bytes]:
    # Multipoint device list, asked on message table 2 under subtype 0x02.
    return req(bytes([V2_PERI_GET, V2_PERI_SUB_DEVICE_LIST]), MSG_COMMAND_2)


def v2_source_switch_request(address: str) -> tuple[int, bytes]:
    # Hands playback to one paired peer by MAC. The address is always written
    # as 17 uppercase-agnostic ASCII MAC bytes after the two opcode bytes.
    if not MAC_RE.match(address):
        raise ValueError(f"invalid Bluetooth address {address!r}")
    return req(bytes([V2_PERI_SET_EXTENDED, V2_PERI_SUB_SOURCE_SWITCH]) + address.encode("ascii"),
               MSG_COMMAND_2)


def v2_refresh_requests(subtype: int = V2_ASC_SUBTYPE_QUERY,
                        eq_subtype: int = V2_EQ_SUBTYPE_DEFAULT,
                        bgm_subtype: int = V2_AUDIO_SUB_BGM) -> list[tuple[int, bytes]]:
    """Everything worth asking for after a v2 connect, in display order.

    Ambient sound is asked under the subtype the device answered during the
    handshake, so a device that supports noise adaptation (0x19) is never
    misread through the dormant legacy parameter it also answers. Equalizer and
    background music are asked under their own discovered subtypes for the same
    reason.
    """
    return [
        req(bytes([V2_BATTERY_GET, V2_BATTERY_SINGLE])),
        v2_audio_codec_get(),
        # v2 firmware is still read with the v1 opcode, subtype 0x02.
        req(bytes([FW_VERSION_REQUEST, 0x02])),
        v2_asc_get(subtype),
        v2_eq_get(eq_subtype),
        v2_system_get(V2_SYSTEM_SUB_SPEAK_TO_CHAT),
        v2_system_get(V2_SYSTEM_SUB_PAUSE_WHEN_TAKEN_OFF),
        v2_apo_get(),
        v2_stc_get(),
        v2_dsee_get(),
        v2_connection_quality_get(),
        v2_bgm_get(bgm_subtype),
        v2_cinema_get(),
        v2_device_list_get(),
        # Voice guidance. The canonical v2 GET is the 2-byte `46 01`, but a
        # WH-1000XM6 (firmware 3.1.5) was captured answering the v1-shaped
        # 3-byte `46 01 01` with `47 01 00 03`, so the refresh sends the
        # proven 3-byte shape.
        req(bytes([VOICE_NOTIFICATIONS_GET, 0x01, 0x01]), MSG_COMMAND_2),
    ]


# ---------------------------------------------------------------------------
# Replies
# ---------------------------------------------------------------------------


def _bool(value: int):
    return {0x00: False, 0x01: True}.get(value)


def derive_listening_mode(bgm_enabled: bool, cinema_enabled: bool) -> str:
    """The mode the app shows, from the two independent wire flags.

    Background Music takes priority over Upmix Cinema when both somehow read as
    on, matching the vendor app, so exactly one of the three modes is reported.
    """
    if bgm_enabled:
        return "background-music"
    if cinema_enabled:
        return "cinema"
    return "standard"


def parse_v2_device_list(payload: bytes):
    """Decode a multipoint device list from v2's PERIPHERAL family.

    This family rides message table 2 (MSG_COMMAND_2), not table 1. Layout is
    [opcode, subtype, count, entries..., playbackStatus]: the subtype says
    whether each entry carries a 3-byte class-of-device (0x02) or not (0x00),
    and the trailing byte names the peer that currently owns playback. An entry
    is 17 ASCII MAC bytes, one connected-status byte, the optional class bytes,
    then a one-byte name length followed by that many UTF-8 name bytes. A
    device is the active playback source when it is connected and its status
    byte equals the trailing playbackStatus. Malformed or truncated input
    yields None so the caller can leave the previous state alone.
    """
    if len(payload) < 4 or payload[1] not in (0x00, 0x02):
        return None
    with_class = payload[1] == 0x02
    count = payload[2]
    if not 0 < count < 16:
        return [] if count == 0 else None
    playback_status = payload[-1]

    devices = []
    index = 3
    for _ in range(count):
        if index + 17 > len(payload):
            return None
        address = payload[index:index + 17].decode("utf-8", "replace")
        index += 17
        if not MAC_RE.match(address):
            # The peer address is attacker-controlled and also seeds the name
            # fallback, so a non-MAC value is replaced before either is stored.
            address = "unknown"
        if index >= len(payload):
            return None
        status = payload[index]
        index += 1
        if with_class:
            if index + 3 > len(payload):
                return None
            index += 3
        if index >= len(payload):
            return None
        name_length = payload[index]
        index += 1
        # Leave at least the trailing playbackStatus byte for the next read.
        if index + name_length >= len(payload):
            return None
        name_bytes = payload[index:index + name_length]
        index += name_length
        try:
            name = name_bytes.decode("utf-8")
        except UnicodeDecodeError:
            name = address
        name = _clean_name(name, address)
        connected = status != 0
        devices.append({
            "address": address,
            "name": name,
            "connected": connected,
            "playback": connected and status == playback_status,
        })
    return devices


def initial_state() -> dict:
    return {
        "connected": False,
        # "v1" or "v2" once the init handshake has said which; None before that.
        "protocol": None,
        "address": None,
        "name": None,
        "firmware": None,
        "codec": None,
        "battery": None,
        "charging": None,
        "nc_mode": None,
        "ambient_level": None,
        "focus_on_voice": None,
        "supports_wind": None,
        "asc_subtype": None,
        "asc_auto_ambient": None,
        "asc_noise_adapt_sensitivity": None,
        "eq_preset": None,
        "eq_bass": None,
        "eq_bands": None,
        "eq_band_count": None,
        "eq_subtype": None,
        "dsee": None,
        "connection_quality": None,
        "listening_mode": None,
        # Multipoint peers and whichever one currently owns playback, both
        # filled from the PERIPHERAL device-list family on protocol v2.
        "devices": None,
        "playback_source": None,
        "bgm_room_size": None,
        "bgm_subtype": None,
        "bgm_enabled": False,
        "cinema_enabled": False,
        "speak_to_chat": None,
        "stc_sensitivity": None,
        "stc_focus_on_voice": None,
        "stc_timeout": None,
        "pause_when_taken_off": None,
        "auto_power_off": None,
        "touch_sensor": None,
        "voice_notifications": None,
        "nc_optimizer_pressure": None,
        "features": [],
        "error": None,
        # Write-then-verify. `pending` lists the setting keys that have been
        # written but not yet confirmed by the device's own read-back; `refused`
        # maps a key the device acknowledged without changing to a short reason.
        # Both are separate from `error`, which is for connection-level
        # failures only, so a discarded write keeps its association with a row.
        "pending": [],
        "refused": {},
        # The control-session policy and whether the daemon currently holds the
        # session. The daemon owns these fields and stamps the live values on
        # at its boundary; a bare link reports the neutral held/hold/30.
        "session": "held",
        "session_policy": SESSION_POLICY_DEFAULT,
        "session_idle": SESSION_IDLE_DEFAULT,
        # The helper's own log level. It rides in the state so the panel can
        # read it — and change it over the socket — the same way as anything
        # the headphones report.
        "logging": log_level(),
    }


def _apply_firmware(state: dict, payload: bytes) -> None:
    """Record the firmware string; both generations read it through v1's opcode."""
    version = payload[3:].decode("ascii", "replace")
    if re.fullmatch(r"[0-9.\-a-zA-Z_]+", version):
        state["firmware"] = version


def _apply_codec(state: dict, payload: bytes) -> None:
    """Record the codec byte; both generations index it through AUDIO_CODECS."""
    state["codec"] = AUDIO_CODECS.get(payload[2], f"0x{payload[2]:02x}")


def _apply_battery(state: dict, payload: bytes, subtypes: tuple[int, ...],
                   minimum: int | None = None, maximum: int | None = None) -> None:
    """Record battery percentage and charging flag.

    v1 accepts the single/case subtypes with no bound on the percentage; v2
    accepts only the single subtype and bounds it to 0..100. Callers have
    already checked the payload length.
    """
    if payload[1] not in subtypes:
        return
    level = payload[2]
    if minimum is not None and level < minimum:
        return
    if maximum is not None and level > maximum:
        return
    state["battery"] = level
    state["charging"] = payload[3] == 0x01


def apply_payload(state: dict, msg_type: int, payload: bytes) -> bool:
    """Fold one reply or notification into `state`. Returns True if anything moved.

    Unknown or malformed payloads are ignored rather than raising: the
    headphones emit plenty of chatter this plugin has no use for, and a widget
    that dies on an unrecognised byte is worse than one that shrugs.
    """
    if not payload:
        return False

    before = dict(state)
    code = payload[0]

    if msg_type == MSG_COMMAND_2:
        if code in (VOICE_NOTIFICATIONS_RET, VOICE_NOTIFICATIONS_NOTIFY) and len(payload) == 4:
            state["voice_notifications"] = _bool(payload[3])
        return state != before

    if code == FW_VERSION_REPLY and len(payload) >= 4 and payload[1] == 0x02:
        _apply_firmware(state, payload)

    elif code in (CODEC_RET, CODEC_NOTIFY) and len(payload) == 3:
        _apply_codec(state, payload)

    elif code in (BATTERY_RET, BATTERY_NOTIFY) and len(payload) >= 4:
        _apply_battery(state, payload, (BATTERY_SINGLE, BATTERY_CASE))

    elif code in (ASC_RET, ASC_NOTIFY) and len(payload) == 8:
        supports_wind = payload[3] == 0x02
        table = ASC_MODE_FROM_CODE if supports_wind else ASC_MODE_FROM_CODE_NO_WIND
        mode = "off" if payload[2] == 0x00 else table.get(payload[4])
        level = payload[7]
        if mode is not None and 0 <= level <= MAX_AMBIENT_LEVEL:
            state["supports_wind"] = supports_wind
            state["nc_mode"] = mode
            state["ambient_level"] = level
            state["focus_on_voice"] = _bool(payload[6])

    elif code in (EQUALIZER_RET, EQUALIZER_NOTIFY) and len(payload) == 10:
        preset = EQ_PRESET_FROM_CODE.get(payload[2])
        if preset is not None:
            state["eq_preset"] = preset
            state["eq_bass"] = payload[4] - 10
            state["eq_bands"] = [payload[5 + i] - 10 for i in range(5)]

    elif code in (UPSAMPLING_RET, UPSAMPLING_NOTIFY) and len(payload) == 4:
        # 0x01 is LDAC (inverted), 0x02 is DSEE Extreme.
        if payload[1] == 0x02:
            state["dsee"] = _bool(payload[3])

    elif code in (APO_RET, APO_NOTIFY) and len(payload) >= 4:
        sub = payload[1]
        if sub == APO_SUB_AUTO_POWER_OFF and len(payload) == 5:
            value = AUTO_POWER_OFF_FROM_CODE.get((payload[3], payload[4]))
            if value is not None:
                state["auto_power_off"] = value
        elif sub == APO_SUB_PAUSE_WHEN_TAKEN_OFF and len(payload) == 4:
            state["pause_when_taken_off"] = _bool(payload[3])
        elif sub == APO_SUB_SPEAK_TO_CHAT and len(payload) == 4 and payload[2] in (0x00, 0x01):
            # payload[2] says what this frame is about: a query answers with
            # 0x00 and a write echoes 0x01, both carrying the on/off flag,
            # while 0x02 reports something else entirely (a WH-1000XM4 emits
            # `f9 05 02 00` right after being switched on) and must not be
            # mistaken for the setting.
            state["speak_to_chat"] = _bool(payload[3])

    elif code in (STC_CONFIG_RET, STC_CONFIG_NOTIFY) and len(payload) == 6 and payload[1] == 0x05:
        sensitivity = STC_SENSITIVITY_FROM_CODE.get(payload[3])
        timeout = STC_TIMEOUT_FROM_CODE.get(payload[5])
        if sensitivity is not None and timeout is not None:
            state["stc_sensitivity"] = sensitivity
            state["stc_focus_on_voice"] = _bool(payload[4])
            state["stc_timeout"] = timeout

    elif code in (TOUCH_RET, TOUCH_NOTIFY) and len(payload) == 4 and payload[1] == 0xD2:
        state["touch_sensor"] = _bool(payload[3])

    elif code in (NC_OPTIMIZER_STATE_RET, NC_OPTIMIZER_STATE_NOTIFY) and len(payload) == 6:
        pressure = payload[5] / 10.0
        if 0 < pressure <= 1.0:
            state["nc_optimizer_pressure"] = pressure

    return state != before


def apply_payload_v2(state: dict, msg_type: int, payload: bytes) -> bool:
    """Fold one v2 reply or notification into `state`. Returns True if anything moved.

    Like the v1 parser, unknown or malformed payloads are ignored rather than
    raising: the headphones emit plenty of chatter this plugin has no use for.
    """
    if not payload:
        return False

    before = dict(state)
    code = payload[0]

    # The multipoint device list rides message table 2 on v2, so it is read
    # here: the v1 parser handles MSG_COMMAND_2 only for voice notifications
    # and is never reached on a v2 link.
    if msg_type == MSG_COMMAND_2:
        if code in (V2_PERI_RET, V2_PERI_NOTIFY):
            devices = parse_v2_device_list(payload)
            if devices is not None:
                state["devices"] = devices
                state["playback_source"] = next(
                    (device["address"] for device in devices if device["playback"]), None)
        # Voice guidance is inverted (0x00 = on) with the value at index 2;
        # the trailing byte's meaning is unknown, so it is never required
        # or interpreted beyond the length check.
        if code in (VOICE_NOTIFICATIONS_RET, VOICE_NOTIFICATIONS_NOTIFY) and len(payload) >= 4:
            state["voice_notifications"] = payload[2] == 0x00
        return state != before

    # v2 still reads firmware through the v1 opcode, so the branch has to live
    # here: a v2 link is routed exclusively to this parser and never reaches the
    # v1 one, where the identical check sits for older devices.
    if code == FW_VERSION_REPLY and len(payload) >= 4 and payload[1] == 0x02:
        _apply_firmware(state, payload)

    elif code in (V2_AUDIO_CODEC_RET, V2_AUDIO_CODEC_NOTIFY) and len(payload) == 3 and payload[1] == 0x02:
        _apply_codec(state, payload)

    elif code in (V2_AUDIO_RET, V2_AUDIO_NOTIFY) and len(payload) >= 3:
        sub = payload[1]
        if sub == V2_AUDIO_SUB_DSEE and len(payload) == 3 and payload[2] in (0, 1):
            state["dsee"] = payload[2] == 0x01
        elif sub == V2_AUDIO_SUB_CONNECTION_QUALITY and len(payload) == 3 and payload[2] in (0, 1):
            state["connection_quality"] = "stable" if payload[2] == 0x01 else "sound-quality"
        elif sub == V2_AUDIO_SUB_UPMIX_CINEMA and len(payload) == 3:
            # Upmix Cinema is inverted: 0x00 means on.
            state["cinema_enabled"] = payload[2] == 0x00
            state["listening_mode"] = derive_listening_mode(
                state.get("bgm_enabled"), state["cinema_enabled"])
        elif sub in (V2_AUDIO_SUB_BGM, V2_AUDIO_SUB_BGM_ALT) and len(payload) >= 4:
            room = V2_BGM_ROOM_FROM_CODE.get(payload[3])
            if room is not None:
                # Background Music is inverted too, and carries the room byte.
                state["bgm_enabled"] = payload[2] == 0x00
                state["bgm_room_size"] = room
                state["bgm_subtype"] = sub
                state["listening_mode"] = derive_listening_mode(
                    state["bgm_enabled"], state.get("cinema_enabled"))

    if code in (V2_BATTERY_RET, V2_BATTERY_NOTIFY) and len(payload) >= 4:
        _apply_battery(state, payload, (V2_BATTERY_SINGLE,), minimum=0, maximum=100)

    elif code in (V2_ASC_RET, V2_ASC_NOTIFY) and len(payload) >= 6:
        subtype = payload[1]
        if subtype in V2_ASC_SUBTYPES:
            on_off = payload[3]
            has_wind = subtype == V2_ASC_SUBTYPE_WIND
            if subtype == V2_ASC_SUBTYPE_NA and len(payload) >= 9:
                # [type, status, onOff, ncAsmMode, focus, level, auto, sensitivity]
                ambient, focus, level = payload[4], payload[5], payload[6]
                auto_ambient, sensitivity = payload[7], payload[8]
            else:
                # The shorter shapes end in focus and level; the ambient-only
                # subtype carries no ambient byte of its own.
                ambient = 0x01 if subtype == V2_ASC_SUBTYPE_AMBIENT else payload[4]
                focus, level = payload[-2], payload[-1]
                auto_ambient, sensitivity = None, None
            if on_off == 0x00:
                mode = "off"
            elif subtype == V2_ASC_SUBTYPE_AMBIENT or ambient == 0x01:
                mode = "ambient-sound"
            else:
                mode = "noise-cancelling"
            if focus in (0x00, 0x01) and 0 <= level <= MAX_AMBIENT_LEVEL:
                state["supports_wind"] = has_wind
                state["asc_subtype"] = subtype
                state["nc_mode"] = mode
                state["ambient_level"] = level
                state["focus_on_voice"] = focus == 0x01
                if auto_ambient is not None:
                    state["asc_auto_ambient"] = auto_ambient == 0x01
                    state["asc_noise_adapt_sensitivity"] = sensitivity

    elif code in (V2_EQ_RET, V2_EQ_NOTIFY) and len(payload) >= 4:
        subtype = payload[1]
        band_count = payload[3]
        if subtype in (0x00, 0x02, 0x04) and 4 + band_count <= len(payload):
            # Six-band replies use the classic offset-ten layout; ten-band use six.
            offset = 10 if band_count == 6 else V2_EQ_BAND_OFFSET
            state["eq_preset"] = V2_EQ_PRESET_FROM_CODE.get(payload[2])
            state["eq_bass"] = None
            state["eq_bands"] = [payload[4 + i] - offset for i in range(band_count)]
            state["eq_band_count"] = band_count
            state["eq_subtype"] = subtype

    elif code in (V2_SYSTEM_RET, V2_SYSTEM_NOTIFY) and len(payload) >= 2:
        sub = payload[1]
        if sub == V2_SYSTEM_SUB_SPEAK_TO_CHAT and len(payload) == 4:
            disabled = payload[2]
            if disabled in (0x00, 0x01):
                state["speak_to_chat"] = disabled == 0x00
        elif sub == V2_SYSTEM_SUB_PAUSE_WHEN_TAKEN_OFF and len(payload) == 3:
            disabled = payload[2]
            if disabled in (0x00, 0x01):
                state["pause_when_taken_off"] = disabled == 0x00

    elif code in (V2_APO_RET, V2_APO_NOTIFY) and len(payload) >= 2:
        sub = payload[1]
        if sub == V2_APO_SUB_AUTO_POWER_OFF and len(payload) == 4:
            value = V2_AUTO_POWER_OFF_FROM_CODE.get(payload[2])
            if value is not None:
                state["auto_power_off"] = value
        elif sub == V2_SYSTEM_SUB_PAUSE_WHEN_TAKEN_OFF and len(payload) == 3:
            # Some firmware answers pause-when-taken-off on the POWER family.
            disabled = payload[2]
            if disabled in (0x00, 0x01):
                state["pause_when_taken_off"] = disabled == 0x00

    elif code in (V2_STC_CONFIG_RET, V2_STC_CONFIG_NOTIFY) and len(payload) == 4:
        if payload[1] == V2_STC_CONFIG_SUB:
            sensitivity = STC_SENSITIVITY_FROM_CODE.get(payload[2])
            timeout = STC_TIMEOUT_FROM_CODE.get(payload[3])
            if sensitivity is not None:
                state["stc_sensitivity"] = sensitivity
            if timeout is not None:
                state["stc_timeout"] = timeout

    return state != before


# ---------------------------------------------------------------------------
# SDP: which RFCOMM channel is the control service on?
# ---------------------------------------------------------------------------
#
# BlueZ exposes no API for a remote device's service records and bluez-utils
# dropped sdptool, so we ask the device ourselves over L2CAP. Guessing instead
# is not an option: RFCOMM refuses every channel but the right one, and a
# blocking connect to a closed channel takes seconds, so walking 1..30 costs
# minutes and hammers the headphones on the way.

SDP_PSM = 1
SDP_SERVICE_SEARCH_ATTR_REQUEST = 0x06
SDP_SERVICE_SEARCH_ATTR_RESPONSE = 0x07
RFCOMM_PROTOCOL_UUID = 0x0003
SERVICE_UUID_BYTES = bytes.fromhex(SERVICE_UUID.replace("-", ""))
SERVICE_UUID_V2_BYTES = bytes.fromhex(SERVICE_UUID_V2.replace("-", ""))

# The device decides how long this exchange runs and how much it sends, so both
# are capped here rather than left to it. A real answer is a few hundred bytes
# in one or two rounds; a peer that keeps handing back continuations — out of
# malice or a fault — is cut off instead of held in memory and waited on.
SDP_RECV_SIZE = 2048
SDP_MAX_RECORD_BYTES = 8192   # aggregate attribute bytes across every round
SDP_MAX_ROUNDS = 8            # request/response pairs, continuations included
SDP_MAX_CONTINUATION = 16     # the spec caps continuation information at 16 bytes
SDP_MAX_DEPTH = 16            # element nesting; a real record is three or four deep


class SdpError(ValueError):
    """The device's answer was malformed, oversized, or never finished."""


def _de_sequence(body: bytes) -> bytes:
    return bytes([(6 << 3) | 5, len(body)]) + body


def _de_uuid128(raw: bytes) -> bytes:
    return bytes([(3 << 3) | 4]) + raw


def _de_uint32(value: int) -> bytes:
    return bytes([(1 << 3) | 2]) + value.to_bytes(4, "big")


def _parse_element(data: bytes, index: int, depth: int = 0):
    """Decode one SDP data element. Sequences come back as lists, UUIDs as tuples.

    Recursive, so nesting is capped: without that a record of a few thousand
    bytes can be nothing but sequence headers and exhaust the stack.
    """
    if depth > SDP_MAX_DEPTH:
        raise SdpError("the service record is nested too deeply")
    header = data[index]
    index += 1
    element_type, size_index = header >> 3, header & 0x07

    if size_index < 5:
        length = (1, 2, 4, 8, 16)[size_index]
        if element_type == 0:  # nil carries no bytes at all
            return None, index
    elif size_index == 5:
        length = data[index]
        index += 1
    elif size_index == 6:
        length = int.from_bytes(data[index:index + 2], "big")
        index += 2
    else:
        length = int.from_bytes(data[index:index + 4], "big")
        index += 4

    end = index + length
    if end > len(data):
        raise SdpError("an element runs past the end of the service record")
    body = data[index:end]

    if element_type in (6, 7):
        items = []
        cursor = index
        while cursor < end:
            value, cursor = _parse_element(data, cursor, depth + 1)
            items.append(value)
        if cursor != end:
            raise SdpError("an element runs past the end of its sequence")
        return items, end
    if element_type in (1, 2):
        return int.from_bytes(body, "big"), end
    if element_type == 3:
        return ("uuid", int.from_bytes(body, "big")), end
    if element_type == 5:
        return bool(body[0]), end
    return body, end


def _find_rfcomm_channel(node):
    """A protocol descriptor is [RFCOMM uuid, channel]; find the first one.

    The channel is the device's to name and SDP is unauthenticated, so only
    the range an RFCOMM socket address can carry is accepted: an out-of-range
    value is treated as no channel at all.
    """
    if not isinstance(node, list):
        return None
    if (len(node) >= 2 and isinstance(node[0], tuple) and node[0][0] == "uuid"
            and node[0][1] == RFCOMM_PROTOCOL_UUID and isinstance(node[1], int)
            and 1 <= node[1] <= 30):
        return node[1]
    for child in node:
        found = _find_rfcomm_channel(child)
        if found is not None:
            return found
    return None


def sdp_query(sock, uuid: bytes, timeout: float, clock=time.monotonic) -> bytes:
    """Run a service search on a connected SDP socket; return the record bytes.

    The answer may arrive in pieces, each ending in a continuation state that
    has to be sent back to get the next one. Everything about that loop is
    the device's to decide, so all of it is bounded: the total record size,
    the number of rounds, and the wall-clock time for the whole exchange —
    not just each read, which a peer can satisfy forever by answering just in
    time. A continuation must also make progress and never repeat; a peer
    replaying one is going in circles, whatever the round count says.
    """
    deadline = clock() + timeout
    record = bytearray()
    continuation = b"\x00"
    seen: set[bytes] = set()

    def remaining() -> float:
        left = deadline - clock()
        if left <= 0:
            raise SdpError("the device did not finish answering in time")
        return left

    for transaction in range(1, SDP_MAX_ROUNDS + 1):
        params = (_de_sequence(_de_uuid128(uuid))
                  + struct.pack(">H", 0xFFFF)
                  + _de_sequence(_de_uint32(0x0000FFFF))
                  + continuation)
        sock.settimeout(remaining())
        sock.send(struct.pack(">BHH", SDP_SERVICE_SEARCH_ATTR_REQUEST, transaction, len(params)) + params)
        sock.settimeout(remaining())
        response = sock.recv(SDP_RECV_SIZE)

        if len(response) < 5:
            raise SdpError("the response is shorter than its header")
        pdu, answered, param_length = struct.unpack(">BHH", response[:5])
        if pdu != SDP_SERVICE_SEARCH_ATTR_RESPONSE:
            raise SdpError(f"unexpected SDP response 0x{pdu:02x}")
        if answered != transaction:
            raise SdpError("the response answers a different request")
        body = response[5:5 + param_length]
        if len(body) != param_length or len(body) < 2:
            raise SdpError("the response is shorter than it declares")

        count = int.from_bytes(body[:2], "big")
        chunk = body[2:2 + count]
        if len(chunk) != count:
            raise SdpError("the attribute bytes run past the response")
        if len(record) + count > SDP_MAX_RECORD_BYTES:
            raise SdpError("the service record is larger than any real one")
        record += chunk

        # A missing continuation byte is off-spec but unambiguous: nothing
        # follows. It was accepted before and costs nothing to keep accepting.
        rest = body[2 + count:]
        if not rest or rest[0] == 0:
            return bytes(record)

        if rest[0] > SDP_MAX_CONTINUATION or len(rest) != 1 + rest[0]:
            raise SdpError("the continuation state is malformed")
        if count == 0:
            raise SdpError("a continuation arrived without any data")
        if rest in seen:
            raise SdpError("the device repeated a continuation state")
        seen.add(rest)
        continuation = rest

    raise SdpError("the device kept asking for more rounds than any real record needs")


def parse_sdp_record(record: bytes):
    # Anything after the first element is ignored, as it always was: it costs
    # nothing, and rejecting it would only risk a device that works today.
    tree, _ = _parse_element(record, 0)
    return tree


def sdp_channel(address: str, uuid: bytes = SERVICE_UUID_BYTES, timeout: float = 8.0) -> int | None:
    """Ask the device which RFCOMM channel carries `uuid`, or None.

    `timeout` covers the whole lookup, connecting included.
    """
    deadline = time.monotonic() + timeout
    sock = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_SEQPACKET, socket.BTPROTO_L2CAP)
    sock.settimeout(timeout)
    try:
        sock.connect((address, SDP_PSM))
        record = sdp_query(sock, uuid, deadline - time.monotonic())
        if not record:
            return None
        return _find_rfcomm_channel(parse_sdp_record(record))
    except (OSError, SdpError, IndexError, struct.error):
        return None
    finally:
        sock.close()

# ---------------------------------------------------------------------------
# Finding the headphones
# ---------------------------------------------------------------------------

CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "omarchy-sony-headphones",
)

MAC_RE = re.compile(r"^([0-9A-F]{2}:){5}[0-9A-F]{2}$", re.IGNORECASE)

_NAME_WHITESPACE_RE = re.compile(r"\s+")
_NAME_CONTROLS_RE = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def _clean_name(text: str, fallback: str) -> str:
    """Make a device- or peer-supplied name inert single-line text.

    The remote device chooses its own friendly name, and it is fully
    attacker-controlled: it can carry ANSI/OSC escape sequences, newlines,
    C0/C1 controls or an unbounded length. That text reaches a terminal (OSC
    52 rewrites the clipboard, OSC 8 spoofs links), the log (a newline forges
    an entry) and shared QML components whose textFormat this repo does not
    control (Qt's rich text can load remote images). Strip controls, squeeze
    whitespace to single spaces, bound the length and fall back to the address
    when nothing readable survives. This is control/format neutrality, not
    ASCII folding: legitimate Unicode letters are meant to pass through.
    """
    if not text:
        return fallback
    collapsed = _NAME_WHITESPACE_RE.sub(" ", text)
    cleaned = _NAME_CONTROLS_RE.sub("", collapsed).strip()[:64].strip()
    return cleaned or fallback


# Where BlueZ actually installs bluetoothctl. The daemon is long-lived and
# inherits whatever environment started the bar, so resolving the name through
# PATH would let anything earlier on that PATH answer for it; the list is
# searched once, at import, and the absolute result is what gets executed.
BLUETOOTHCTL_CANDIDATES = ("/usr/bin/bluetoothctl", "/bin/bluetoothctl", "/usr/local/bin/bluetoothctl")

# A minimal environment for the same reason. LC_ALL pins the locale because we
# parse the output; PATH is present only because bluetoothctl expects one.
BLUETOOTHCTL_ENV = {"PATH": "/usr/bin:/bin", "LC_ALL": "C"}


def find_bluetoothctl() -> str | None:
    for candidate in BLUETOOTHCTL_CANDIDATES:
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


BLUETOOTHCTL = find_bluetoothctl()


def bluetoothctl(*args: str, timeout: float = 5.0) -> str:
    if BLUETOOTHCTL is None:
        return ""
    try:
        done = subprocess.run(
            [BLUETOOTHCTL, *args],
            check=False, capture_output=True, text=True, timeout=timeout,
            env=BLUETOOTHCTL_ENV,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return done.stdout


INFO_MAX_LINES = 256  # one device's `bluetoothctl info` is a few dozen lines


def service_protocol(info: str) -> str | None:
    """Which command set a device's SDP record says it speaks, or None.

    BlueZ lists the remote service UUIDs in `bluetoothctl info`, so this is a
    cheap lookup. The v2 UUID is checked first: a device that advertises it (and
    none do both) speaks v2.

    Only indented `UUID:` lines count, except when the dump's first line is
    the UUID line itself. `bluetoothctl info` prints the `Name:`/`Alias:`
    value verbatim, so a hostile friendly name containing a newline plus
    `UUID: <sony-uuid>` starts a fresh unindented line that a
    strip-then-match would trust. Genuine property lines always carry BlueZ's
    leading-tab indentation (only the `Device ...` header starts at column
    zero, and never with a UUID), so requiring the tab tells a real UUID
    property apart from name content spilling onto a later line. A bare
    first line cannot be such spillover — spillover always follows the
    `Name:`/`Alias:` line — so it keeps the historical single-line match.
    The scan covers at most INFO_MAX_LINES lines.
    """
    uuids = []
    for index, line in enumerate(info.splitlines()[:INFO_MAX_LINES]):
        stripped = line.strip().lower()
        if not stripped.startswith("uuid:"):
            continue
        if line.startswith("\t") or index == 0:
            uuids.append(stripped)
    text = "\n".join(uuids)
    if SERVICE_UUID_V2 in text:
        return "v2"
    if SERVICE_UUID in text:
        return "v1"
    return None


# How long a connected-device list is trusted. The daemon retries every 2-30 s
# while nothing is connected, so this is the window that collapses one
# operation's several lookups (find_device inside try_connect inside run, plus
# a scan per device) into a single one. It has to stay short: a just-connected
# device must appear promptly, so nothing negative is remembered for longer.
DISCOVERY_TTL = 2.0


def _normalize_mac(address: str) -> str:
    """A stable key for an address regardless of case or separators."""
    return address.replace(":", "").lower()


class _DiscoveryCache:
    """In-memory discovery cache — never on disk.

    A persisted protocol hint would be attacker-influenceable without the
    private-directory and O_NOFOLLOW treatment the channel cache gets, and it
    buys nothing: the hint only orders UUID queries and Link's init handshake
    overwrites it. So this is a plain dict in the process.

    The list is time-limited so a device that just connected is picked up after
    the TTL; the per-MAC protocol hint lasts for the process lifetime, because
    a present device keeps advertising the same service. A search that finds no
    Sony service stores no hint, so it can be answered afresh next scan.
    """

    def __init__(self, ttl: float = DISCOVERY_TTL, clock=time.monotonic):
        self.ttl = ttl
        self._clock = clock
        self._devices = None  # (expiry, snapshot)
        self._hints = {}      # normalized MAC -> "v1" | "v2"

    def cached_devices(self) -> list[dict] | None:
        if self._devices is not None and self._clock() < self._devices[0]:
            return self._devices[1]
        return None

    def remember_devices(self, devices: list[dict]) -> None:
        self._devices = (self._clock() + self.ttl, devices)

    def protocol_hint(self, address: str) -> str | None:
        return self._hints.get(_normalize_mac(address))

    def remember_protocol(self, address: str, protocol: str | None) -> None:
        # Only a positive answer is kept: a device with no advertised service
        # may grow one, and must not be pinned to "none" for the process.
        if protocol is not None:
            self._hints[_normalize_mac(address)] = protocol


_DISCOVERY = _DiscoveryCache()


def connected_devices(*, live: bool = False) -> list[dict]:
    """Connected Bluetooth devices that advertise a Sony app service.

    The result is cached in memory for a couple of seconds so a burst of calls
    from one operation collapses to a single scan. `live=True` deliberately
    bypasses the cache for diagnostics that want a fresh view; the protocol is
    still only a hint — Link's init handshake is what decides it.
    """
    if not live:
        cached = _DISCOVERY.cached_devices()
        if cached is not None:
            return cached
    devices = []
    for line in bluetoothctl("devices", "Connected").splitlines():
        parts = line.split(None, 2)
        if len(parts) < 2 or parts[0] != "Device" or not MAC_RE.match(parts[1]):
            continue
        address = parts[1]
        name = _clean_name(parts[2] if len(parts) > 2 else address, address)
        protocol = None if live else _DISCOVERY.protocol_hint(address)
        if protocol is None:
            protocol = service_protocol(bluetoothctl("info", address))
            if not live:
                _DISCOVERY.remember_protocol(address, protocol)
        if protocol is not None:
            devices.append({"address": address, "name": name, "protocol": protocol})
    if not live:
        _DISCOVERY.remember_devices(devices)
    return devices


def find_device(preferred: str | None = None) -> dict | None:
    devices = connected_devices()
    if preferred:
        for device in devices:
            if device["address"].lower() == preferred.lower():
                return device
        return None
    return devices[0] if devices else None


def _channel_cache_path(address: str) -> str:
    return os.path.join(CACHE_DIR, _normalize_mac(address) + ".channel")


def cached_channel(address: str) -> int | None:
    try:
        fd = os.open(_channel_cache_path(address), os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd) as handle:
            channel = int(handle.read(32).strip())
    except (OSError, ValueError):
        return None
    return channel if 1 <= channel <= 30 else None


def private_cache_dir() -> str | None:
    """CACHE_DIR, made private, or nothing.

    The cached channel decides where the next connection is dialled, so the
    directory holding it should be no more reachable than the runtime one.
    ~/.cache is normally the user's own, which is why this is a smaller matter
    than the socket — but the directory may predate this check, or have been
    left loose by whatever created it, so it is tightened rather than assumed.

    A cache is an optimisation: anything that cannot be made private is
    declined, and channel discovery simply runs again.
    """
    try:
        os.mkdir(CACHE_DIR, 0o700)
    except FileExistsError:
        info = os.lstat(CACHE_DIR)
        # Ours and a real directory, but looser than it should be: fix it.
        # A symlink, or somebody else's, is not ours to correct.
        if stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid():
            if stat.S_IMODE(info.st_mode) != 0o700:
                os.chmod(CACHE_DIR, 0o700)
        else:
            return None
    except OSError:
        return None
    return CACHE_DIR if is_private_dir(CACHE_DIR) else None


def remember_channel(address: str, channel: int) -> None:
    try:
        if private_cache_dir() is None:
            return
        path = _channel_cache_path(address)
        # O_NOFOLLOW for the same reason as the lock: write the file we named,
        # or nothing. O_TRUNC is fine here — the file is ours and its whole
        # content is the number being replaced.
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w") as handle:
            handle.write(str(channel))
    except OSError:
        pass


def forget_channel(address: str) -> None:
    try:
        os.remove(_channel_cache_path(address))
    except OSError:
        pass


# ---------------------------------------------------------------------------
# The local log
# ---------------------------------------------------------------------------
#
# A human-readable companion to the frame trace. The trace is a byte-level
# view of one conversation, switched on for a run; the log is a bounded,
# always-there record of what the helper did, for when a puzzle has to be
# worked out after the fact. Both are local-only: the log never goes to stdout
# (the shell parses stdout as JSON), never to stderr (the widget reads its
# helper's stderr as an error message), and never over the network.
#
# The design follows the stdlib logging practice that fits a single-file
# helper. One module-level named logger, never the root logger, so a record
# cannot end up in another application's handlers. Lazy "message %s"
# formatting, so the arguments are only stringified when a record is really
# emitted. One RotatingFileHandler with small bounds, because a log is a
# debugging aid and not a record of everything. Configuration happens once, at
# startup, from SONY_HEADPHONES_LOG; a runtime change moves the handler's
# level alone, which needs no reconfiguration and no threads.
#
# The user-facing names are the three the panel offers. `off` is a level above
# CRITICAL, so nothing can be emitted; `errors` keeps failures, the parser
# boundary and lost links; `all` adds the connection lifecycle and every
# command applied. Anything that is not a known name means `errors`, so a typo
# can never silence the log.
#
# The file lives in the same private cache directory as the channel cache and
# is opened the same way the lock is: O_NOFOLLOW, 0600, and checked to be ours
# before a byte is written. A symlink parked on the name, or a file someone
# else can read, would each be a way to redirect or watch what the helper
# writes. The file itself is created on the first record, so a run that logs
# nothing touches nothing. Bluetooth addresses are redacted from every
# formatted line; the frame trace remains the one channel that carries raw
# bytes, and it stays opt-in.

LOG_FILE_NAME = "sony-headphones.log"
LOG_MAX_BYTES = 256 * 1024
LOG_BACKUPS = 2
LOG_DEFAULT = "errors"
# Above CRITICAL, so no record can pass a handler carrying this level.
LOG_OFF = logging.CRITICAL + 10
LOG_LEVELS = {"off": LOG_OFF, "errors": logging.ERROR, "all": logging.DEBUG}

# A fixed name rather than __name__, which is "__main__" when the helper runs
# as a script and something else when a test loads the file: the log belongs
# to the helper, not to whoever imported it.
LOG = logging.getLogger("sony-headphones")
# Until configure_logging runs there is nowhere to write. The NullHandler is
# the stdlib idiom that keeps a record from falling through to the root
# logger's lastResort handler, which would print it to stderr.
LOG.addHandler(logging.NullHandler())
LOG.propagate = False


class _LogFormatter(logging.Formatter):
    """A formatter that redacts Bluetooth addresses and keeps one line per record.

    The address is a stable hardware identifier and nothing the log answers
    needs it. Redacting in the formatter also catches an address embedded in
    an exception message or its traceback, which rewriting the record's
    arguments would miss. Stripping controls here does the same for CR/LF: a
    device name or a command value carrying a newline would otherwise forge
    log entries, and the formatter is the one place every record crosses.
    """

    # MAC_RE's anchors make it a validator; this one has to find an address
    # anywhere in a line.
    ADDRESS = re.compile(r"(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}")

    def format(self, record):
        # Strip controls from the message text only, so a value carrying a
        # newline cannot forge an entry, then format a copy: the exception and
        # stack text that Formatter appends keeps its own newlines, which a
        # traceback needs. Formatting a copy leaves the original record for
        # any other handler.
        message = _NAME_CONTROLS_RE.sub("", record.getMessage())
        record = logging.makeLogRecord(record.__dict__)
        record.msg = message
        record.args = ()
        line = super().format(record)
        return self.ADDRESS.sub("<address>", line)


class _PrivateLogFile(logging.handlers.RotatingFileHandler):
    """A rotating handler that opens its file the way the lock is opened.

    RotatingFileHandler would open the log by name through the builtin open,
    following a symlink parked on the path and keeping whatever mode the file
    happened to have. O_NOFOLLOW, an owner check and fchmod make the file
    private or fail. Overriding _open also covers rotation, because
    doRollover reopens through the same method, and the delayed open keeps the
    cache directory untouched until the first record is actually emitted.
    """

    def _open(self):
        # The private-cache check runs here rather than at construction so a
        # run that never logs never creates the directory either.
        if private_cache_dir() is None:
            raise OSError("the log directory is not private")
        fd = os.open(
            self.baseFilename,
            os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
        )
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
                raise OSError(f"{self.baseFilename} is not a log file owned by this user")
            os.fchmod(fd, 0o600)
        except OSError:
            os.close(fd)
            raise
        return os.fdopen(fd, self.mode, encoding=self.encoding)


def _open_log_handler():
    """The rotating file handler, or None when it cannot be built.

    Failure is deliberately quiet: the handler opens its file on the first
    record, and an open that fails (no private directory, a symlink on the
    name, someone else's file) is dropped by the logging module's own error
    path. A logging failure must never become the failure being logged.
    """
    try:
        handler = _PrivateLogFile(
            os.path.join(CACHE_DIR, LOG_FILE_NAME),
            maxBytes=LOG_MAX_BYTES,
            backupCount=LOG_BACKUPS,
            encoding="utf-8",
            delay=True,
        )
    except (OSError, ValueError):
        return None
    handler.setFormatter(_LogFormatter(
        "%(asctime)s %(levelname)s %(message)s", datefmt="%Y-%m-%d %H:%M:%S"))
    return handler


def _log_level_name(setting) -> str:
    """The user-facing name for a setting, always a valid one.

    SONY_HEADPHONES_LOG is read once at startup; a typo must not silence the
    log or fail the helper, so anything that is not a known name is `errors`.
    """
    name = str(setting).strip().lower() if setting is not None else ""
    return name if name in LOG_LEVELS else LOG_DEFAULT


_LOG_HANDLER = None
_LOG_LEVEL = LOG_DEFAULT


def log_level() -> str:
    """The level name in effect, for state and the `logging` command."""
    return _LOG_LEVEL


def configure_logging(setting=None) -> str:
    """Install the local handler once, then only move its level.

    main() calls this at startup with SONY_HEADPHONES_LOG; the daemon calls it
    again when the level changes over its socket. The first call builds the
    handler, formatter and logger; every later call is a setLevel on the
    handler alone, which leaves the file and the format untouched. Returns the
    level name in effect, so a caller can report what it got.
    """
    global _LOG_HANDLER, _LOG_LEVEL
    _LOG_LEVEL = _log_level_name(
        os.environ.get("SONY_HEADPHONES_LOG") if setting is None else setting)
    if _LOG_HANDLER is None:
        # The import-time NullHandler, and anything else already attached, is
        # replaced by the file handler; if none can be built a fresh
        # NullHandler keeps records from reaching the root logger.
        for existing in list(LOG.handlers):
            LOG.removeHandler(existing)
        _LOG_HANDLER = _open_log_handler() or logging.NullHandler()
        LOG.addHandler(_LOG_HANDLER)
        # DEBUG on the logger and the level on the handler: the handler is
        # what moves at runtime, and the fallback carries a level just the
        # same. Silencing handleError keeps a formatting or rotation failure
        # out of stderr, which the widget would read as an error message.
        LOG.setLevel(logging.DEBUG)
        logging.raiseExceptions = False
    _LOG_HANDLER.setLevel(LOG_LEVELS[_LOG_LEVEL])
    return _LOG_LEVEL


# ---------------------------------------------------------------------------
# The RFCOMM link
# ---------------------------------------------------------------------------


class NotConnected(Exception):
    pass


class Transport:
    """The bytes-moving half of a Link.

    A Link owns framing, the handshake, dispatch and the parser boundary;
    where the bytes come from is the transport's business. A transport finds
    the channel (`open` returns it once the connection is up), moves whole
    frames in and out, and says when the peer has gone. `recv` raises
    socket.timeout when the caller's window closes first and NotConnected or
    OSError when the peer hangs up, so a Link can tell "nothing yet" from
    "gone"; `connected` is what Link asks before writing.

    `open` optionally takes the caller's `attempt` callback, which is handed
    each connected candidate before it counts as the channel. An attempt that
    raises NotConnected, OSError or ProtocolError marks that candidate a dead
    end, and the transport closes it and tries the next one.
    """

    sock = None

    @property
    def connected(self) -> bool:
        return self.sock is not None

    def open(self, timeout: float, attempt=None) -> int:
        raise NotImplementedError

    def send(self, frame: bytes) -> None:
        raise NotImplementedError

    def recv(self, timeout: float) -> bytes:
        raise NotImplementedError

    def close(self) -> None:
        raise NotImplementedError


class RfcommTransport(Transport):
    """The real radio: SDP discovery, RFCOMM sockets and the bytes between.

    The candidate list is built lazily, in the order it always was: the
    device's own SDP record decides the channel, the last one that worked is
    the fallback, and the protocol hint only changes which UUID is searched
    first. The hint-ordered first UUID is asked straight away; the second is
    only asked if the first answers nothing, or after the first candidate has
    been offered and failed. Sockets are opened in that order, and each one is
    offered to the caller's `attempt` before it counts as the control channel:
    a candidate the attempt rejects is closed and the next is tried, and the
    cached channel is forgotten once none of them works.
    """

    def __init__(self, link: Link):
        self.link = link
        self.sock: socket.socket | None = None
        # Set by Link.connect from the bluetoothctl hint before the search.
        self.protocol_hint: str | None = None

    def _open_channel(self, channel: int, timeout: float) -> socket.socket:
        sock = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
        # BlueZ's RFCOMM refuses a non-blocking connect outright, so connect
        # blocking (BlueZ applies its own timeout) and only then arm the read
        # timeout the rest of the conversation runs on.
        sock.setblocking(True)
        sock.connect((self.link.address, channel))
        sock.settimeout(timeout)
        return sock

    def _candidates(self):
        """Yield control channels in priority order, querying SDP lazily.

        The second UUID is only queried once the first has been dealt with —
        a device that answers one UUID and handshakes on it costs one SDP
        query, not two. The cached channel is a local read and comes last.
        Duplicates are skipped.
        """
        order = (SERVICE_UUID_V2_BYTES, SERVICE_UUID_BYTES)
        if self.protocol_hint == "v1":
            order = (SERVICE_UUID_BYTES, SERVICE_UUID_V2_BYTES)
        seen = set()
        for uuid in order:
            discovered = sdp_channel(self.link.address, uuid=uuid)
            if discovered and discovered not in seen:
                seen.add(discovered)
                yield discovered
        known = cached_channel(self.link.address)
        if known and known not in seen:
            seen.add(known)
            yield known

    def open(self, timeout: float, attempt=None) -> int:
        last_error = None
        offered = False
        for channel in self._candidates():
            offered = True
            try:
                self.sock = self.link._open(channel, timeout)
            except OSError as exc:
                if exc.errno == errno.EBUSY:
                    # One control session only: a phone holding it over
                    # multipoint makes our open fail busy, so say so plainly
                    # instead of burning through the remaining candidates.
                    raise NotConnected(
                        "another device may be using the control channel"
                    ) from exc
                last_error = exc
                continue
            if attempt is None:
                return channel
            try:
                attempt(channel)
            except (NotConnected, OSError, ProtocolError) as exc:
                # The socket connected but the conversation did not: this
                # candidate is a dead end, so close it and try the next one
                # before declaring the device unreachable.
                last_error = exc
                self.close()
                continue
            return channel

        if not offered:
            raise NotConnected(
                f"could not find Sony's control service on {self.link.address}; "
                "is this a Sony device, and is it connected?"
            )
        forget_channel(self.link.address)
        raise NotConnected(
            f"could not open Sony's control channel on {self.link.address}"
            + (f": {last_error}" if last_error else "")
        )

    def send(self, frame: bytes) -> None:
        self.sock.sendall(frame)

    def recv(self, timeout: float) -> bytes:
        self.sock.settimeout(timeout)
        chunk = self.sock.recv(1024)
        if not chunk:
            raise NotConnected("the headphones closed the connection")
        return chunk

    def close(self) -> None:
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None


class Link:
    """One conversation with a pair of headphones, over whatever transport.

    Sony's protocol is strictly lock-step: every message is answered with an
    ACK carrying the flipped sequence number, and every message the headphones
    send has to be acknowledged the same way. Miss an ACK and the device stops
    talking, so the read loop below acknowledges first and interprets after.
    """

    ACK_TIMEOUT = 2.0
    # A link whose device has its answer queued by the time write returns
    # needs no settle wait: apply_setting drains once and is done.
    answers_immediately = False

    def __init__(self, address: str, on_change=None, transport: Transport | None = None):
        self.address = address
        self.on_change = on_change
        self.state = initial_state()
        self.state["address"] = address
        # "v1" or "v2" once the init handshake has answered; None before that.
        self.protocol: str | None = None
        # The command set behind that name: every wire decision goes through
        # it. v1 is the default until a handshake says otherwise, which is
        # also what an unconfirmed link used to get.
        self.adapter: Protocol = V1Protocol()
        # Where the bytes come from. A real link gets the RFCOMM transport
        # wired back to this link; the demo passes its stand-in transport in.
        self.transport = transport if transport is not None else RfcommTransport(self)
        self.seq = 0
        self._buffer = bytearray()
        self.last_rx = 0.0
        # Set when a Background-music write raises: the daemon reads it in
        # lose_link to explain a link the write took down (see BGM_WRITE_KEYS).
        self.interrupted_key: str | None = None

    # The socket stays reachable under its old name: the daemon selects on it
    # and the tests stand streams in for it. It lives on the transport.
    @property
    def sock(self):
        return self.transport.sock

    @sock.setter
    def sock(self, stream) -> None:
        self.transport.sock = stream

    # -- connection ---------------------------------------------------------

    def _open(self, channel: int, timeout: float) -> socket.socket:
        """Build the socket for one candidate channel.

        The socket itself is the transport's to create; this hook stays on
        Link because that is where a stand-in stream has always been slipped
        in, and the transport opens candidates through it.
        """
        return self.transport._open_channel(channel, timeout)

    def connect(self, timeout: float = 6.0, protocol: str | None = None) -> int:
        """Open the link and complete the init handshake. Returns the channel.

        The transport finds and opens the control channel; the v1 and v2
        control service UUIDs are searched there — the device answers only the
        one it speaks — with a protocol hint (from `bluetoothctl info`) putting
        the likely one first and the other only asked if the first falls
        through. Each candidate is settled by `_establish` before the next is
        tried, so a channel that connects but does not answer the init
        handshake falls through rather than failing the whole connect. Any
        failure that survives every candidate abandons the connection and
        forgets the cached channel: a cache pointing at a channel that no
        longer works costs a connect and buys nothing.
        """
        self.transport.protocol_hint = protocol
        try:
            channel = self.transport.open(timeout, attempt=self._establish)
            self.state["error"] = None
            LOG.info("connected on channel %s (%s)", channel, self.protocol)
            return channel
        except (NotConnected, OSError, ProtocolError) as exc:
            # An attempt may have left the link marked connected while it was
            # in flight; a failed connect is not a connection.
            self.state["connected"] = False
            forget_channel(self.address)
            LOG.error("connect failed: %s", exc)
            raise NotConnected(
                f"could not open Sony's control channel on {self.address}: {exc}"
            ) from exc
        finally:
            # The successful path returned with the link marked connected;
            # every other outcome, bug included, leaves no socket behind.
            if not self.state["connected"]:
                self.close()

    def _establish(self, channel: int) -> None:
        """Settle one connected candidate: handshake, features, dialects.

        This runs before Link.connect has accepted the candidate, so an
        exception from here (NotConnected, OSError or ProtocolError) is the
        transport's signal to close this socket and try the next candidate.
        Sequence and buffer are reset per candidate: a half-finished
        conversation must not carry into the next socket.
        """
        self.seq = 0
        self._buffer.clear()
        self.state["connected"] = False
        if not self._handshake():
            raise NotConnected("the device did not answer the init handshake")
        # The confirmed protocol, not the advertised UUID or the bluetoothctl
        # hint, decides what the device can be offered.
        self.state["features"] = features_for(self.state.get("name"), self.protocol)
        # Marking the link connected here, before the dialect queries, matches
        # the old connect loop: a notification that arrives during negotiation
        # describes a link that is up.
        self.state["connected"] = True
        # The dialect queries are part of opening the link, not an optional
        # extra: a device that drops during one of them has not given us a
        # usable connection. A command set with nothing to negotiate makes
        # this a no-op.
        self.adapter.negotiate(self)
        remember_channel(self.address, channel)

    def _set_protocol(self, protocol: str) -> None:
        """Adopt the command set the init handshake confirmed.

        The name stays on Link because the state and the QML read it; the
        adapter is what the wire decisions use from here on.
        """
        self.protocol = protocol
        self.state["protocol"] = protocol
        self.adapter = V2Protocol() if protocol == "v2" else V1Protocol()

    def _handshake(self) -> bool:
        """Send INIT and wait for the device to identify itself.

        The init reply's length is the only reliable v1/v2 discriminator: four
        bytes is v1, eight is v2 (WF-1000XM4, XM5/XM6, LinkBuds, CH720N…).
        Both command sets are implemented here; the reply picks which one the
        rest of the conversation uses.

        The headphones sometimes ignore the first INIT of a session, usually
        just after a previous one closed, so ask again rather than declaring
        the device silent. Repeated INITs are harmless: the device answers
        every one of them.
        """
        for _ in range(3):
            self.write(MSG_COMMAND_1, bytes([INIT_REQUEST, 0x00]), wait_ack=False)
            deadline = time.monotonic() + self.ACK_TIMEOUT
            while time.monotonic() < deadline:
                frame = self._read_frame(deadline - time.monotonic())
                if frame is None:
                    break  # nothing more is coming in this window; ask again
                msg_type, seq, payload = frame
                if msg_type == MSG_ACK:
                    self.seq = seq
                    continue
                self._ack(seq)
                if payload and payload[0] == INIT_REPLY:
                    self._set_protocol("v1" if len(payload) == 4 else "v2")
                    return True
                self.dispatch(msg_type, payload)
        return False

    def close(self) -> None:
        was_connected = self.state.get("connected")
        self.transport.close()
        self.state["connected"] = False
        if was_connected:
            LOG.info("disconnected")

    # -- framing ------------------------------------------------------------

    def _read_frame(self, timeout: float):
        """Read one complete frame, or None if the timeout expires first.

        Markers cannot appear inside an escaped body, so a trailer byte always
        ends a frame and a header byte always starts one.
        """
        deadline = time.monotonic() + max(0.0, timeout)
        while True:
            end = self._buffer.find(TRAILER)
            if end != -1:
                start = self._buffer.rfind(HEADER, 0, end)
                raw = bytes(self._buffer[start:end + 1]) if start != -1 else None
                del self._buffer[:end + 1]
                if raw is None or len(raw) > MAX_MESSAGE_SIZE:
                    trace("rx", raw or b"", None,
                          "oversized frame dropped" if raw else "trailer with no header dropped")
                    continue
                try:
                    message = decode_message(raw)
                except ProtocolError:
                    trace("rx", raw, None, "malformed frame dropped")
                    continue
                self.last_rx = time.monotonic()
                trace("rx", raw, message)
                return message

            remaining = deadline - time.monotonic()
            if remaining <= 0 or not self.transport.connected:
                return None
            try:
                chunk = self.transport.recv(remaining)
            except socket.timeout:
                return None
            except OSError as exc:
                if exc.errno == errno.EINTR:
                    continue
                raise
            if not chunk:
                raise NotConnected("the headphones closed the connection")
            self._buffer.extend(chunk)
            self._trim_buffer()

    def _trim_buffer(self) -> None:
        """Keep at most one frame's worth of bytes that have no trailer yet.

        The buffer outlives each read, so a device that never sends a trailer
        would otherwise grow it for as long as the link stays up. No real frame
        is longer than MAX_MESSAGE_SIZE: past that, only a header close enough
        to the end to still start a valid frame is worth keeping.
        """
        if len(self._buffer) <= MAX_MESSAGE_SIZE or TRAILER in self._buffer:
            return
        start = self._buffer.rfind(HEADER)
        if start == -1 or len(self._buffer) - start > MAX_MESSAGE_SIZE:
            self._buffer.clear()
        else:
            del self._buffer[:start]

    def _ack(self, their_seq: int) -> None:
        if not self.transport.connected:
            return
        frame = encode_message(MSG_ACK, 1 - their_seq, b"")
        self.transport.send(frame)
        trace("tx", frame, decode_message(frame))

    def write(self, msg_type: int, payload: bytes, wait_ack: bool = True) -> None:
        if not self.transport.connected:
            raise NotConnected("not connected")
        frame = encode_message(msg_type, self.seq, payload)
        self.transport.send(frame)
        trace("tx", frame, decode_message(frame))
        if wait_ack:
            self.wait_for_ack()

    def wait_for_ack(self) -> bool:
        deadline = time.monotonic() + self.ACK_TIMEOUT
        while time.monotonic() < deadline:
            frame = self._read_frame(deadline - time.monotonic())
            if frame is None:
                break
            msg_type, seq, payload = frame
            if msg_type == MSG_ACK:
                self.seq = seq
                return True
            self._ack(seq)
            self.dispatch(msg_type, payload)
        return False

    # -- conversation -------------------------------------------------------

    def dispatch(self, msg_type: int, payload: bytes) -> None:
        """Fold one frame into state through the link's adapter.

        A parser ignores what it cannot read, so anything that escapes one is
        a bug, not device chatter. The daemon above catches only NotConnected
        and OSError, so an unexpected parser error is traced and dropped here
        rather than allowed to take the daemon down over one frame.
        """
        try:
            changed = self.adapter.apply(self.state, msg_type, payload)
        except Exception as exc:
            trace("rx", b"", None,
                  f"type={msg_type} payload={payload.hex()} parser error ignored ({exc!r})")
            LOG.error("parser error ignored: type=%s payload=%s: %s",
                      msg_type, payload.hex(), exc, exc_info=True)
            return
        if changed:
            self.notify_change()

    def notify_change(self) -> None:
        """Fan out a state change made outside dispatch.

        `dispatch` is not the only writer: `apply_setting` records a pending
        write and its outcome directly on the state. Routing that through here
        keeps one way for the owner to hear about a change.
        """
        if self.on_change:
            self.on_change(self.state)

    def pump(self, timeout: float) -> None:
        """Read and process whatever the headphones have to say for a while."""
        deadline = time.monotonic() + timeout
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return
            frame = self._read_frame(remaining)
            if frame is None:
                return
            msg_type, seq, payload = frame
            if msg_type == MSG_ACK:
                self.seq = seq
                continue
            self._ack(seq)
            self.dispatch(msg_type, payload)

    def request(self, requests: list[tuple[int, bytes]], settle: float = 0.25) -> None:
        for msg_type, payload in requests:
            self.write(msg_type, payload)
        self.pump(settle)

    def refresh(self) -> dict:
        self.request(self.adapter.refresh_requests(self.state), settle=0.6)
        return self.state

    def _select_subtype(self, candidates: tuple[int, ...], getter,
                        state_key: str, default: int | None) -> int | None:
        """Ask which dialect of a subtype-keyed family this device answers.

        The candidates are asked in order and the first one whose reply lands
        in `state_key` wins, so each caller's order decides which dialect is
        preferred when a device answers more than one. A device that answers
        none keeps whatever it last reported, falling back to `default`.
        """
        for subtype in candidates:
            self.write(*getter(subtype))
            self.pump(0.3)
            if self.state.get(state_key) == subtype:
                return subtype
        return self.state.get(state_key) or default

    def select_asc_subtype(self) -> int | None:
        """Ask which ambient-sound dialect this device answers, and remember it.

        A v2 device that supports noise adaptation (0x19) still answers the
        older 0x17 parameter out of a dormant slot, so the subtype cannot be
        guessed from a reply alone: V2_ASC_PROBE_ORDER is the probe order,
        query subtype first, and the first one that answers wins.
        """
        return self._select_subtype(V2_ASC_PROBE_ORDER, v2_asc_get, "asc_subtype", None)

    def select_eq_subtype(self) -> int | None:
        """Ask which equalizer dialect this device answers, and remember it.

        The WH-1000XM6 answers subtype 0x04 and silently ignores 0x00, but the
        subtype is asked rather than assumed so XM5-style devices that speak
        0x00 still work: the candidates are tried in order and the first one
        that answers wins.
        """
        return self._select_subtype(
            (V2_EQ_SUBTYPE_DEFAULT, 0x00), v2_eq_get, "eq_subtype", V2_EQ_SUBTYPE_DEFAULT)

    def select_bgm_subtype(self) -> int | None:
        """Ask which background-music dialect this device answers, and remember it.

        The WH-1000XM6 answers subtype 0x09, but some firmware uses 0x03, so the
        candidates are tried in order and the first one that answers wins. A
        device that answers neither keeps the default for the next ask.
        """
        return self._select_subtype(
            (V2_AUDIO_SUB_BGM, V2_AUDIO_SUB_BGM_ALT), v2_bgm_get, "bgm_subtype",
            V2_AUDIO_SUB_BGM)

    def poll_requests(self) -> list[tuple[int, bytes]]:
        return self.adapter.poll_requests(self.state)

    def power_off(self) -> None:
        self.adapter.power_off(self)


def configure_link(link: Link, device: dict) -> int:
    """Give a fresh link its device identity and open the handshake.

    The name and the bluetoothctl protocol hint go on the state first, so a
    failure still describes the right device and offers only its generation's
    controls. Link.connect replaces the hint with the features of the protocol
    the handshake confirmed, so the hint never outlives a successful connect.
    """
    link.state["name"] = device["name"]
    link.state["features"] = features_for(device["name"], device.get("protocol"))
    return link.connect(protocol=device.get("protocol"))


# ---------------------------------------------------------------------------
# Protocol adapters
# ---------------------------------------------------------------------------
#
# v1 and v2 are two command sets over one framing. Link treats that as one
# seam: it asks its adapter what to send and what a reply meant, and never
# looks at the protocol name. Each adapter is a thin delegate to the builders
# and parsers written for its generation — their wire layouts genuinely differ
# and stay separate — so the seam introduces no second copy of any layout.
# The adapter is chosen once, by the init handshake, and does not change for
# the life of the link.


class Protocol:
    """What a Link needs to know about one generation's command set.

    The methods mirror the wire decisions a link makes; the base class
    exists to name them, and each concrete adapter fills them in.
    """

    def negotiate(self, link: Link) -> None:
        """Settle whatever the command set needs before first use, if anything."""
        raise NotImplementedError

    def refresh_requests(self, state: dict) -> list[tuple[int, bytes]]:
        """Everything worth asking for after a connect, in display order."""
        raise NotImplementedError

    def poll_requests(self, state: dict) -> list[tuple[int, bytes]]:
        """The periodic liveness question, in this generation's dialect."""
        raise NotImplementedError

    def apply(self, state: dict, msg_type: int, payload: bytes) -> bool:
        """Fold one reply or notification into state; True if anything moved."""
        raise NotImplementedError

    def setting_requests(self, state: dict, key: str, value) -> list[tuple[int, bytes]]:
        """Turn one setting change into the requests that carry it."""
        raise NotImplementedError

    def power_off(self, link: Link) -> None:
        """Ask the headphones to turn off, on the command sets that offer it."""
        raise NotImplementedError


class V1Protocol(Protocol):
    """The v1 ("MDR") command set: WH-1000XM2/XM3/XM4, WF-SP800N…"""

    def negotiate(self, link: Link) -> None:
        # v1 has no subtype-keyed dialects to discover.
        return None

    def refresh_requests(self, state: dict) -> list[tuple[int, bytes]]:
        return refresh_requests()

    def poll_requests(self, state: dict) -> list[tuple[int, bytes]]:
        return [req(bytes([BATTERY_GET, BATTERY_SINGLE]))]

    def apply(self, state: dict, msg_type: int, payload: bytes) -> bool:
        return apply_payload(state, msg_type, payload)

    def setting_requests(self, state: dict, key: str, value) -> list[tuple[int, bytes]]:
        return setting_requests(state, key, value)

    def power_off(self, link: Link) -> None:
        link.write(MSG_COMMAND_1, bytes([POWER_OFF, 0x00]))


class V2Protocol(Protocol):
    """The v2 command set: WH-1000XM5/XM6, WF-1000XM5, LinkBuds, CH720N…"""

    def negotiate(self, link: Link) -> None:
        # v2 reuses opcodes across features and tells them apart by subtype, so
        # each subtype-keyed family is asked which dialect it answers first.
        link.select_asc_subtype()
        link.select_eq_subtype()
        link.select_bgm_subtype()

    def refresh_requests(self, state: dict) -> list[tuple[int, bytes]]:
        # Subtype 0x00 is a real equalizer dialect, so it must not be
        # collapsed by a truthiness fallback; only a missing one defaults.
        eq_subtype = state.get("eq_subtype")
        return v2_refresh_requests(
            state.get("asc_subtype") or V2_ASC_SUBTYPE_QUERY,
            eq_subtype=V2_EQ_SUBTYPE_DEFAULT if eq_subtype is None else eq_subtype,
            bgm_subtype=state.get("bgm_subtype") or V2_AUDIO_SUB_BGM,
        )

    def poll_requests(self, state: dict) -> list[tuple[int, bytes]]:
        return [
            req(bytes([V2_BATTERY_GET, V2_BATTERY_SINGLE])),
            v2_asc_get(state.get("asc_subtype") or V2_ASC_SUBTYPE_QUERY),
        ]

    def apply(self, state: dict, msg_type: int, payload: bytes) -> bool:
        return apply_payload_v2(state, msg_type, payload)

    def setting_requests(self, state: dict, key: str, value) -> list[tuple[int, bytes]]:
        return setting_requests_v2(state, key, value)

    def power_off(self, link: Link) -> None:
        raise ValueError("turning the headphones off is not supported over v2")


# ---------------------------------------------------------------------------
# Settings
# ---------------------------------------------------------------------------

BOOL_SETTINGS = {
    # key: (opcode, sub-type, spacer byte, state key)
    "dsee": (UPSAMPLING_SET, 0x02, 0x00, "dsee"),
    "speak-to-chat": (APO_SET, APO_SUB_SPEAK_TO_CHAT, 0x01, "speak_to_chat"),
    "pause-when-taken-off": (APO_SET, APO_SUB_PAUSE_WHEN_TAKEN_OFF, 0x00, "pause_when_taken_off"),
    "touch-sensor": (TOUCH_SET, 0xD2, 0x01, "touch_sensor"),
}

SETTING_KEYS = sorted(list(BOOL_SETTINGS) + [
    "nc", "ambient-level", "focus-on-voice", "eq", "eq-bands", "auto-power-off",
    "stc-sensitivity", "stc-timeout", "stc-focus-on-voice", "voice-notifications",
    "connection-quality", "listening-mode", "bgm-room-size", "playback-source",
])


def parse_bool(value, current=None) -> bool:
    if isinstance(value, bool):
        return value
    text = str(value).strip().lower()
    if text in ("true", "on", "yes", "1", "enable", "enabled"):
        return True
    if text in ("false", "off", "no", "0", "disable", "disabled"):
        return False
    if text == "toggle":
        return not bool(current)
    raise ValueError(f"expected a boolean, got {value!r}")


def next_nc_mode(current: str | None) -> str:
    """Left-to-right cycle, the same one the headphone's own button walks."""
    order = ["noise-cancelling", "ambient-sound", "off"]
    if current not in order:
        return order[0]
    return order[(order.index(current) + 1) % len(order)]


SETTING_FEATURES = {
    "eq": "equalizer",
    "eq-bands": "equalizer",
    "dsee": "dsee",
    "connection-quality": "connection-quality",
    "playback-source": "multipoint",
    "listening-mode": "listening-mode",
    "bgm-room-size": "listening-mode",
    "speak-to-chat": "speak-to-chat",
    "stc-sensitivity": "speak-to-chat",
    "stc-timeout": "speak-to-chat",
    "stc-focus-on-voice": "speak-to-chat",
    "pause-when-taken-off": "pause-when-taken-off",
    "touch-sensor": "touch-sensor",
    "voice-notifications": "voice-notifications",
    "auto-power-off": "auto-power-off",
}

# Setting keys that only exist on one generation. The feature list normally
# gates them, but a stale or missing list must not let a write cross protocols,
# so each builder refuses the other side's keys outright.
V1_ONLY_SETTINGS = {"touch-sensor"}
V2_ONLY_SETTINGS = {"connection-quality", "listening-mode", "bgm-room-size", "playback-source"}

# The fields both builders read before they branch on the key: the resolved
# feature list and the ambient state they share, plus the v2 discovery fields
# the v2 builder would otherwise re-read in each arm.
SettingContext = collections.namedtuple("SettingContext", (
    "features mode level focus supports_wind asc_subtype asc_auto_ambient "
    "asc_noise_adapt_sensitivity eq_subtype bgm_subtype"
))


def _setting_context(state: dict, key: str, generation: str,
                     exclusive: set, ceiling: set) -> SettingContext:
    """The preamble both settings builders share.

    Refuses the keys in ``exclusive`` (the other generation's set), resolves the
    feature list (falling back to this generation's ``ceiling``), gates the key
    through SETTING_FEATURES, and reads the common ambient fields and the v2
    discovery fields. Each caller supplies its generation, the set it refuses
    and its own ceiling, so the two are never merged. The generation-specific
    gates — the v1 auto-power-off timer and the v2 voice-focus refusal — stay
    with their builder.
    """
    other = "v2" if generation == "v1" else "v1"
    if key in exclusive:
        raise ValueError(f"{key!r} is a {other} setting and cannot be sent over {generation}")
    features = state.get("features") or sorted(ceiling)
    needed = SETTING_FEATURES.get(key)
    if needed and needed not in features:
        raise ValueError(f"{state.get('name') or 'this device'} does not support {key}")

    mode = state.get("nc_mode") or "off"
    level = state.get("ambient_level")
    level = MAX_AMBIENT_LEVEL if level is None else level
    focus = bool(state.get("focus_on_voice"))
    supports_wind = state.get("supports_wind")
    supports_wind = True if supports_wind is None else supports_wind
    eq_subtype = state.get("eq_subtype")

    return SettingContext(
        features=features,
        mode=mode,
        level=level,
        focus=focus,
        supports_wind=supports_wind,
        asc_subtype=state.get("asc_subtype") or V2_ASC_SUBTYPE_QUERY,
        asc_auto_ambient=0x01 if state.get("asc_auto_ambient") else 0x00,
        asc_noise_adapt_sensitivity=state.get("asc_noise_adapt_sensitivity") or 0x00,
        eq_subtype=V2_EQ_SUBTYPE_DEFAULT if eq_subtype is None else eq_subtype,
        bgm_subtype=state.get("bgm_subtype") or V2_AUDIO_SUB_BGM,
    )


def setting_requests(state: dict, key: str, value) -> list[tuple[int, bytes]]:
    """Turn one setting change into the requests that carry it."""
    ctx = _setting_context(state, key, "v1", V2_ONLY_SETTINGS, V1_FEATURES)
    if key == "auto-power-off" and str(value) not in ("off", "when-taken-off") \
            and "auto-power-off-timer" not in ctx.features:
        raise ValueError(
            f"{state.get('name') or 'this device'} only supports auto power off "
            "'off' or 'when-taken-off'"
        )

    if key == "nc":
        mode = next_nc_mode(ctx.mode) if str(value) == "cycle" else str(value)
        return [asc_request(mode, ctx.level, ctx.focus, ctx.supports_wind)]

    if key == "ambient-level":
        level = finite_int(value)
        # Adjusting the slider is how you ask for ambient sound; jumping there
        # matches what the phone app does and avoids a silent no-op in NC mode.
        mode = ctx.mode
        if mode not in ("ambient-sound", "off"):
            mode = "ambient-sound"
        return [asc_request(mode, level, ctx.focus, ctx.supports_wind)]

    if key == "focus-on-voice":
        return [asc_request(ctx.mode, ctx.level, parse_bool(value, ctx.focus), ctx.supports_wind)]

    if key == "eq":
        return [eq_preset_request(str(value))]

    if key == "eq-bands":
        numbers = [int(v) for v in re.split(r"[,\s]+", str(value).strip()) if v]
        if len(numbers) != 6:
            raise ValueError("eq-bands takes 6 values: clear-bass and 5 bands, each -10..10")
        return [eq_bands_request(numbers[0], numbers[1:])]

    if key == "auto-power-off":
        return [auto_power_off_request(str(value))]

    if key in ("stc-sensitivity", "stc-timeout", "stc-focus-on-voice"):
        sensitivity = state.get("stc_sensitivity") or "auto"
        timeout = state.get("stc_timeout") or "standard"
        stc_focus = bool(state.get("stc_focus_on_voice"))
        if key == "stc-sensitivity":
            sensitivity = str(value)
        elif key == "stc-timeout":
            timeout = str(value)
        else:
            stc_focus = parse_bool(value, stc_focus)
        return [stc_config_request(sensitivity, stc_focus, timeout)]

    if key == "voice-notifications":
        enabled = parse_bool(value, state.get("voice_notifications"))
        return [req(bytes([VOICE_NOTIFICATIONS_SET, 0x01, 0x01, 0x01 if enabled else 0x00]), MSG_COMMAND_2)]

    if key in BOOL_SETTINGS:
        opcode, sub, spacer, state_key = BOOL_SETTINGS[key]
        return [bool_request(opcode, sub, spacer, parse_bool(value, state.get(state_key)))]

    raise ValueError(f"unknown setting {key!r}; expected one of {', '.join(SETTING_KEYS)}")


def setting_requests_v2(state: dict, key: str, value) -> list[tuple[int, bytes]]:
    """Turn one setting change into the v2 requests that carry it.

    A read-back of the affected value follows each write: the device announces
    ambient-sound changes under a subtype that does not carry the whole state,
    so the authoritative answer is asked for rather than inferred.
    """
    ctx = _setting_context(state, key, "v2", V1_ONLY_SETTINGS, V2_FEATURES)
    if key == "stc-focus-on-voice":
        # v1-only, but it maps to the shared speak-to-chat feature, so it needs its own refusal.
        raise ValueError(
            f"{state.get('name') or 'this device'} does not support voice focus while chatting"
        )

    if key == "nc":
        mode = next_nc_mode(ctx.mode) if str(value) == "cycle" else str(value)
        return [v2_asc_request(mode, ctx.level, ctx.focus, ctx.asc_subtype,
                               ctx.asc_auto_ambient, ctx.asc_noise_adapt_sensitivity),
                v2_asc_get(ctx.asc_subtype)]

    if key == "ambient-level":
        level = finite_int(value)
        # Adjusting the slider is how you ask for ambient sound, as on v1.
        mode = ctx.mode
        if mode not in ("ambient-sound", "off"):
            mode = "ambient-sound"
        return [v2_asc_request(mode, level, ctx.focus, ctx.asc_subtype,
                               ctx.asc_auto_ambient, ctx.asc_noise_adapt_sensitivity),
                v2_asc_get(ctx.asc_subtype)]

    if key == "focus-on-voice":
        return [v2_asc_request(ctx.mode, ctx.level, parse_bool(value, ctx.focus),
                               ctx.asc_subtype, ctx.asc_auto_ambient,
                               ctx.asc_noise_adapt_sensitivity),
                v2_asc_get(ctx.asc_subtype)]

    if key == "eq":
        # 0x00 is a valid XM5-style subtype, so only an unset value defaults.
        return [v2_eq_preset_request(str(value), ctx.eq_subtype), v2_eq_get(ctx.eq_subtype)]

    if key == "eq-bands":
        numbers = [int(v) for v in re.split(r"[,\s]+", str(value).strip()) if v]
        if len(numbers) != V2_EQ_BAND_COUNT:
            raise ValueError(
                f"eq-bands takes {V2_EQ_BAND_COUNT} values, each "
                f"{V2_EQ_BAND_MIN}..{V2_EQ_BAND_MAX}"
            )
        return [v2_eq_bands_request(numbers, ctx.eq_subtype), v2_eq_get(ctx.eq_subtype)]

    if key == "auto-power-off":
        return [v2_auto_power_off_request(str(value)), v2_apo_get()]

    if key in ("stc-sensitivity", "stc-timeout"):
        sensitivity = state.get("stc_sensitivity") or "auto"
        timeout = state.get("stc_timeout") or "standard"
        if key == "stc-sensitivity":
            sensitivity = str(value)
        else:
            timeout = str(value)
        return [v2_stc_config_request(sensitivity, timeout), v2_stc_get()]

    if key == "speak-to-chat":
        enabled = parse_bool(value, state.get("speak_to_chat"))
        return [v2_stc_enabled_request(enabled), v2_system_get(V2_SYSTEM_SUB_SPEAK_TO_CHAT)]

    if key == "pause-when-taken-off":
        enabled = parse_bool(value, state.get("pause_when_taken_off"))
        return [v2_bool_request(V2_SYSTEM_SET, V2_SYSTEM_SUB_PAUSE_WHEN_TAKEN_OFF, enabled),
                v2_system_get(V2_SYSTEM_SUB_PAUSE_WHEN_TAKEN_OFF)]

    if key == "voice-notifications":
        # The v1 builder's generic branch above is never reached on a v2
        # link (the adapter routes to this builder), so v2 needs its own
        # sibling. Unlike v1's 4-byte non-inverted shape, v2 is 3 bytes and
        # inverted: 0x00 = on, 0x01 = off. The GET re-reads the value so
        # write-then-verify confirms against the device's own answer.
        enabled = parse_bool(value, state.get("voice_notifications"))
        return [req(bytes([VOICE_NOTIFICATIONS_SET, 0x01, 0x00 if enabled else 0x01]),
                    MSG_COMMAND_2),
                req(bytes([VOICE_NOTIFICATIONS_GET, 0x01, 0x01]), MSG_COMMAND_2)]

    if key == "dsee":
        enabled = parse_bool(value, state.get("dsee"))
        return [v2_dsee_request(enabled), v2_dsee_get()]

    if key == "connection-quality":
        return [v2_connection_quality_request(str(value)), v2_connection_quality_get()]

    if key == "playback-source":
        # Hand playback to one multipoint peer, then re-read the list so the
        # reported source is the device's own answer rather than our guess.
        value = str(value)
        if not MAC_RE.match(value):
            raise ValueError(f"invalid Bluetooth address {value!r}")
        return [v2_source_switch_request(value), v2_device_list_get()]

    if key == "listening-mode":
        mode = str(value)
        if mode not in ("standard", "background-music", "cinema"):
            raise ValueError(
                f"unknown listening mode {mode!r}; expected one of "
                "standard, background-music, cinema"
            )
        bgm = mode == "background-music"
        cinema = mode == "cinema"
        room = state.get("bgm_room_size") or "living-room"
        return [
            v2_bgm_request(bgm, room, ctx.bgm_subtype),
            v2_cinema_request(cinema),
            v2_bgm_get(ctx.bgm_subtype),
            v2_cinema_get(),
        ]

    if key == "bgm-room-size":
        room = str(value)
        if room not in V2_BGM_ROOM:
            raise ValueError(
                f"unknown room size {room!r}; expected one of {', '.join(V2_BGM_ROOM)}"
            )
        enabled = state.get("listening_mode") == "background-music"
        return [v2_bgm_request(enabled, room, ctx.bgm_subtype), v2_bgm_get(ctx.bgm_subtype)]

    raise ValueError(f"unknown setting {key!r} for this device")


SETTLE_TIMEOUT = 2.0


def _mark_pending(link: Link, key: str) -> None:
    """Note that `key` has been written but the device has not confirmed it.

    The clear of any earlier refusal happens here rather than after a move: a
    new write to the same setting supersedes the last verdict, so the panel
    stops showing a stale refusal while the fresh read-back is awaited.

    New containers rather than in-place edits: `Daemon.publish` snapshots the
    state shallowly, so a fan-out already made must not see these fields move
    under it, or the dedupe would swallow the transition.
    """
    pending = list(link.state.get("pending") or [])
    if key not in pending:
        pending.append(key)
    refused = dict(link.state.get("refused") or {})
    refused.pop(key, None)
    link.state["pending"] = pending
    link.state["refused"] = refused
    link.notify_change()


def _settle_pending(link: Link, key: str, reason: str | None = None) -> None:
    """Drop `key` from pending, recording a refusal reason when there is one."""
    link.state["pending"] = [
        name for name in (link.state.get("pending") or []) if name != key
    ]
    if reason is not None:
        refused = dict(link.state.get("refused") or {})
        refused[key] = reason
        link.state["refused"] = refused
    link.notify_change()


def apply_setting(link: Link, key: str, value) -> dict:
    requests = link.adapter.setting_requests(link.state, key, value)
    # The request list is built (and may refuse the key) before anything is
    # marked: a setting the builder rejects never claims to be in flight.
    _mark_pending(link, key)
    link.interrupted_key = None
    before = dict(link.state)
    try:
        for msg_type, payload in requests:
            link.write(msg_type, payload)

        # The headphones echo every change back as a notification, so wait for the
        # echo rather than a fixed interval: it usually lands in milliseconds, but
        # after a burst of writes a WH-1000XM4 can take the better part of a second,
        # and returning before it arrives reports the old value as the new one.
        # One drain always happens; a link whose device answered inside the write
        # has its echo queued already and breaks straight out of the loop.
        deadline = time.monotonic() + (0 if link.answers_immediately else SETTLE_TIMEOUT)
        while True:
            link.pump(0.15)
            if link.state != before or time.monotonic() >= deadline:
                break

        # An acknowledgement is not agreement: only a read-back that moved proves
        # the write landed. `before` already carries the pending entry, so it is
        # the device's own fields that move here, not our bookkeeping.
        if link.state != before:
            _settle_pending(link, key)
        else:
            _settle_pending(link, key, f"the headphones did not change {key}")
    except Exception:
        # A write or pump that raises after the mark must not leave the key in
        # pending with no expiry and no settle: drop it (publishing the
        # transition) and re-raise so the connection/validation error path
        # still reports the failure. No refusal is recorded — refused is only
        # for an acknowledged write that did not move within the settle window.
        # The exception is remembered when it struck a Background-music key, so
        # the daemon can explain a link the write took down.
        if key in BGM_WRITE_KEYS:
            link.interrupted_key = key
        _settle_pending(link, key)
        raise
    return link.state


# ---------------------------------------------------------------------------
# A stand-in for the headphones
# ---------------------------------------------------------------------------


class DemoTransport(Transport):
    """A transport whose other end is a stand-in device, not a radio.

    Frames go through the real wire format in both directions, so the demo
    exercises the same encoders the hardware would. A send is answered the way
    a device answers: an ACK with the flipped sequence, then whatever replies
    the stand-in produced. The queue is drained by Link's ordinary read loop,
    which is what keeps the demo from being a second copy of the framing.
    """

    def __init__(self, device):
        self.device = device
        self.pending: list[bytes] = []

    @property
    def connected(self) -> bool:
        return True

    def open(self, timeout: float = 0.0) -> int:
        # A stand-in needs no discovery; channel zero stands for the link.
        return 0

    def send(self, frame: bytes) -> None:
        msg_type, seq, payload = decode_message(frame)
        if msg_type == MSG_ACK:
            # A link acknowledging a frame is not something a stand-in device
            # answers: it never initiates a frame of its own to be acked.
            return
        self.pending.append(encode_message(MSG_ACK, 1 - seq, b""))
        for reply_type, reply in self.device.respond(msg_type, payload):
            self.pending.append(encode_message(reply_type, 1 - seq, reply))

    def recv(self, timeout: float) -> bytes:
        if not self.pending:
            raise socket.timeout("the stand-in device has nothing more to say")
        return self.pending.pop(0)

    def close(self) -> None:
        self.pending.clear()


class DemoDevice:
    """Answers requests the way a WH-1000XM4 does, without any Bluetooth.

    It holds device-side values and replies with real reply payloads, so a
    round trip through it exercises the encoders and the parsers against each
    other. That makes it the test double for every setting, and the thing
    behind `--demo`, which is how the panel gets looked at without hardware.
    """

    def __init__(self):
        self.nc_on = True
        self.mode = 0x02          # 0 ambient, 1 wind, 2 noise cancelling
        self.focus_on_voice = False
        self.level = 10
        self.battery = 78
        self.charging = False
        self.eq_preset = 0x00
        self.eq = [10] * 6        # clear bass and five bands, offset by ten
        self.dsee = True
        self.speak_to_chat = False
        self.stc = [0x00, 0x00, 0x01]   # sensitivity, focus on voice, timeout
        self.pause_when_taken_off = True
        self.auto_power_off = (0x11, 0x00)
        self.touch_sensor = True
        self.voice_notifications = True
        # Opt-in no-move mode for the write-then-verify tests: acknowledge a
        # write and answer with the current value without changing it, the way
        # a headset does when it discards a write it ACKs. Off by default, so
        # the ordinary demo and the verify tool still round-trip faithfully.
        self.stubborn = False

    def asc(self) -> bytes:
        # The level byte only carries meaning in ambient sound; noise cancelling
        # reports zero, exactly as asc_request writes it. Reporting the stored
        # level in every mode would invent a reading no real device sends.
        level = self.level if (not self.nc_on or self.mode == 0x00) else 0x00
        return bytes([ASC_RET, 0x02, 0x01 if self.nc_on else 0x00, 0x02, self.mode,
                      0x01, 0x01 if self.focus_on_voice else 0x00, level])

    def equalizer(self) -> bytes:
        return bytes([EQUALIZER_RET, 0x01, self.eq_preset, 0x06] + self.eq)

    def respond(self, msg_type: int, payload: bytes) -> list[tuple[int, bytes]]:
        """One request in, the replies a real device would send back out."""
        if not payload:
            return []
        code, sub = payload[0], (payload[1] if len(payload) > 1 else 0)

        if msg_type == MSG_COMMAND_2:
            if code == VOICE_NOTIFICATIONS_SET and not self.stubborn:
                self.voice_notifications = payload[3] == 0x01
            if code in (VOICE_NOTIFICATIONS_GET, VOICE_NOTIFICATIONS_SET):
                return [(MSG_COMMAND_2, bytes([VOICE_NOTIFICATIONS_RET, 0x01, 0x01,
                                               0x01 if self.voice_notifications else 0x00]))]
            return []

        if code == INIT_REQUEST:
            return [req(bytes([INIT_REPLY, 0x00, 0x40, 0x10]))]
        if code == FW_VERSION_REQUEST:
            version = b"2.5.0"
            return [req(bytes([FW_VERSION_REPLY, 0x02, len(version)]) + version)]
        if code == CODEC_GET:
            return [req(bytes([CODEC_RET, 0x00, 0x10]))]
        if code == BATTERY_GET:
            return [req(bytes([BATTERY_RET, BATTERY_SINGLE, self.battery, 0x01 if self.charging else 0x00]))]
        if code == NC_OPTIMIZER_STATE_GET:
            return [req(bytes([NC_OPTIMIZER_STATE_RET, 0x01, 0x01, 0x01, 0x01, 0x0A]))]

        if code == ASC_SET and not self.stubborn:
            self.nc_on = payload[2] != 0x00
            self.mode = payload[4]
            self.focus_on_voice = payload[6] == 0x01
            self.level = payload[7]
        if code in (ASC_GET, ASC_SET):
            return [req(self.asc())]

        if code == EQUALIZER_SET and not self.stubborn:
            if payload[2] == 0xFF:
                self.eq = list(payload[4:10])
                self.eq_preset = EQ_PRESETS["manual"]
            else:
                self.eq_preset = payload[2]
        if code in (EQUALIZER_GET, EQUALIZER_SET):
            return [req(self.equalizer())]

        if code == UPSAMPLING_SET and sub == 0x02 and not self.stubborn:
            self.dsee = payload[3] == 0x01
        if code in (UPSAMPLING_GET, UPSAMPLING_SET) and sub == 0x02:
            return [req(bytes([UPSAMPLING_RET, 0x02, 0x00, 0x01 if self.dsee else 0x00]))]

        if code in (APO_GET, APO_SET):
            if sub == APO_SUB_SPEAK_TO_CHAT:
                if code == APO_SET and not self.stubborn:
                    self.speak_to_chat = payload[3] == 0x01
                return [req(bytes([APO_RET, sub, 0x01, 0x01 if self.speak_to_chat else 0x00]))]
            if sub == APO_SUB_PAUSE_WHEN_TAKEN_OFF:
                if code == APO_SET and not self.stubborn:
                    self.pause_when_taken_off = payload[3] == 0x01
                return [req(bytes([APO_RET, sub, 0x00, 0x01 if self.pause_when_taken_off else 0x00]))]
            if sub == APO_SUB_AUTO_POWER_OFF:
                if code == APO_SET and not self.stubborn:
                    self.auto_power_off = (payload[3], payload[4])
                return [req(bytes([APO_RET, sub, 0x01, self.auto_power_off[0], self.auto_power_off[1]]))]
            return []

        if code == STC_CONFIG_SET and not self.stubborn:
            self.stc = [payload[3], payload[4], payload[5]]
        if code in (STC_CONFIG_GET, STC_CONFIG_SET):
            return [req(bytes([STC_CONFIG_RET, 0x05, 0x00] + self.stc))]

        if code in (TOUCH_GET, TOUCH_SET) and sub == 0xD2:
            if code == TOUCH_SET and not self.stubborn:
                self.touch_sensor = payload[3] == 0x01
            return [req(bytes([TOUCH_RET, 0xD2, 0x01, 0x01 if self.touch_sensor else 0x00]))]

        return []


class DemoLink(Link):
    """A Link whose other end is a DemoDevice instead of a radio.

    It is a plain Link with a DemoTransport and its identity already settled;
    framing, dispatch and the read loop are the one implementation, not a
    parallel copy that can drift away from the real one.
    """

    # The stand-in's transport queues the answer before write returns.
    answers_immediately = True

    def __init__(self, on_change=None, device=None):
        # A caller that dropped and reopened a session passes the same device
        # back in: a real headset keeps its settings in flash across the gap,
        # and the demo must answer the same way or `tools/verify.py` could
        # never see a write survive a release/reclaim.
        self.device = device if device is not None else DemoDevice()
        super().__init__("00:00:00:00:00:00", on_change=on_change,
                         transport=DemoTransport(self.device))
        self._set_protocol("v1")
        self.state["name"] = "WH-1000XM4 (demo)"
        self.state["features"] = features_for("WH-1000XM4", "v1")
        self.state["connected"] = True

    def connect(self, timeout: float = 0.0, protocol: str | None = None) -> int:
        # A stand-in is born connected: __init__ has already set its identity,
        # protocol and state, and there is no channel to discover.
        return 0


class DemoDeviceV2:
    """Answers requests the way a WH-1000XM6 does, without any Bluetooth.

    Same role as DemoDevice for the v2 command set: it holds device-side values
    and replies with real reply payloads, so an encoder and its parser are
    exercised against each other without hardware.
    """

    def __init__(self):
        self.battery = 82
        self.charging = False
        self.mode = 2          # 0 off, 1 ambient, 2 noise cancelling
        self.level = 12
        self.focus = False
        self.subtype = V2_ASC_SUBTYPE_NA
        self.has_wind = False
        self.auto_ambient = False
        self.sensitivity = 0x00
        self.eq_preset = V2_EQ_PRESETS["off"]
        self.eq_bands = [0] * V2_EQ_BAND_COUNT
        self.speak_to_chat = False
        self.pause_when_taken_off = True
        self.auto_power_off = V2_AUTO_POWER_OFF["when-taken-off"]
        self.stc = (STC_SENSITIVITY["auto"], STC_TIMEOUT["standard"])
        # The v2-only surface: DSEE, connection quality, listening mode and
        # multipoint, none of which have a v1 counterpart to inherit.
        self.dsee = True
        self.connection_quality = V2_CONNECTION_QUALITY_SOUND
        self.bgm_enabled = False
        self.bgm_room = V2_BGM_ROOM["living-room"]
        self.cinema_enabled = False
        self.devices = [
            {"address": "AA:BB:CC:DD:EE:FF", "name": "Phone", "status": 0x01},
            {"address": "11:22:33:44:55:66", "name": "Laptop", "status": 0x02},
        ]
        self.playback_source = None
        # Voice guidance, inverted on the v2 wire (0x00 = on).
        self.voice_notifications = True
        # Opt-in no-move mode for the write-then-verify tests, off by default;
        # see DemoDevice.stubborn.
        self.stubborn = False

    def device_list(self) -> bytes:
        """The multipoint list, shaped the way parse_v2_device_list reads it.

        Subtype 0x02 puts three class-of-device bytes in each entry, and the
        trailing byte is the status of whichever peer owns playback, so a
        status of zero (no peer) leaves none of them flagged.
        """
        playback_status = 0x00
        for device in self.devices:
            if device["address"] == self.playback_source:
                playback_status = device["status"]
        payload = bytearray([V2_PERI_RET, V2_PERI_SUB_DEVICE_LIST, len(self.devices)])
        for device in self.devices:
            payload += device["address"].encode("ascii")
            payload.append(device["status"])
            payload += b"\x04\x01\x00"
            name = device["name"].encode("utf-8")
            payload.append(len(name))
            payload += name
        payload.append(playback_status)
        return bytes(payload)

    def switch_source(self, payload: bytes) -> None:
        """Flag one known peer as the playback source, ignoring anything else."""
        if self.stubborn:
            return
        if len(payload) < 2 + 17:
            return
        try:
            address = payload[2:19].decode("ascii")
        except UnicodeDecodeError:
            return
        for device in self.devices:
            if device["address"].lower() == address.lower():
                self.playback_source = device["address"]
                return

    def audio_reply(self, code: int, sub: int, payload: bytes) -> list[tuple[int, bytes]]:
        """One V2_AUDIO_GET/V2_AUDIO_SET, answered under the subtype asked.

        DSEE is plain on/off; connection quality, Upmix Cinema and Background
        Music are inverted, and Background Music carries the room code. Short
        or nonsensical writes change nothing and are answered with the current
        value, the same shrug the parser gives a malformed frame.
        """
        if sub == V2_AUDIO_SUB_DSEE:
            if code == V2_AUDIO_SET and not self.stubborn \
                    and len(payload) >= 3 and payload[2] in (0x00, 0x01):
                self.dsee = payload[2] == 0x01
            return [req(bytes([V2_AUDIO_RET, sub, 0x01 if self.dsee else 0x00]))]

        if sub == V2_AUDIO_SUB_CONNECTION_QUALITY:
            if code == V2_AUDIO_SET and not self.stubborn \
                    and len(payload) >= 3 \
                    and payload[2] in (V2_CONNECTION_QUALITY_SOUND, V2_CONNECTION_QUALITY_STABLE):
                self.connection_quality = payload[2]
            return [req(bytes([V2_AUDIO_RET, sub, self.connection_quality]))]

        if sub == V2_AUDIO_SUB_UPMIX_CINEMA:
            if code == V2_AUDIO_SET and not self.stubborn \
                    and len(payload) >= 3 and payload[2] in (0x00, 0x01):
                self.cinema_enabled = payload[2] == 0x00
            return [req(bytes([V2_AUDIO_RET, sub, 0x00 if self.cinema_enabled else 0x01]))]

        if sub in (V2_AUDIO_SUB_BGM, V2_AUDIO_SUB_BGM_ALT):
            if code == V2_AUDIO_SET and not self.stubborn \
                    and len(payload) >= 4 \
                    and payload[3] in V2_BGM_ROOM_FROM_CODE:
                self.bgm_enabled = payload[2] == 0x00
                self.bgm_room = payload[3]
            # Echo whichever subtype was asked: some firmware answers the room
            # under 0x03 rather than 0x09, and the read-back follows the
            # subtype the device chose.
            return [req(bytes([V2_AUDIO_RET, sub, 0x00 if self.bgm_enabled else 0x01,
                               self.bgm_room]))]

        return []

    def asc(self) -> bytes:
        if self.subtype == V2_ASC_SUBTYPE_NA:
            return bytes([
                V2_ASC_RET,
                self.subtype,
                0x01,
                0x00 if self.mode == 0 else 0x01,
                0x01 if self.mode == 1 else 0x00,
                0x01 if self.focus else 0x00,
                self.level,
                0x01 if self.auto_ambient else 0x00,
                self.sensitivity,
            ])
        payload = bytearray([
            V2_ASC_RET,
            self.subtype,
            0x01,
            0x00 if self.mode == 0 else 0x01,
            0x01 if self.mode == 1 else 0x00,
        ])
        if self.has_wind:
            payload.append(0x02)
        payload.append(0x01 if self.focus else 0x00)
        payload.append(self.level)
        return bytes(payload)

    def equalizer(self) -> bytes:
        return bytes(
            [V2_EQ_RET, V2_EQ_SUBTYPE_DEFAULT, self.eq_preset, V2_EQ_BAND_COUNT]
            + [b + V2_EQ_BAND_OFFSET for b in self.eq_bands]
        )

    def respond(self, msg_type: int, payload: bytes) -> list[tuple[int, bytes]]:
        """One request in, the replies a real device would send back out."""
        if not payload:
            return []
        code, sub = payload[0], (payload[1] if len(payload) > 1 else 0)

        if msg_type == MSG_COMMAND_2:
            if code == V2_PERI_GET and sub == V2_PERI_SUB_DEVICE_LIST:
                return [(MSG_COMMAND_2, self.device_list())]
            if code == V2_PERI_SET_EXTENDED and sub == V2_PERI_SUB_SOURCE_SWITCH:
                self.switch_source(payload)
                return []
            # Voice guidance, v2 shape: the value sits at index 2 and is
            # inverted (0x00 = on); the trailing byte is echoed as 0x01 and
            # carries no interpreted meaning. The GET is answered in either
            # the canonical 2-byte (`46 01`) or the v1-shaped 3-byte
            # (`46 01 01`) form.
            if code == VOICE_NOTIFICATIONS_SET and not self.stubborn \
                    and len(payload) >= 3 and payload[2] in (0x00, 0x01):
                self.voice_notifications = payload[2] == 0x00
            if code in (VOICE_NOTIFICATIONS_GET, VOICE_NOTIFICATIONS_SET) \
                    and len(payload) >= 2:
                return [(MSG_COMMAND_2, bytes([VOICE_NOTIFICATIONS_RET, 0x01,
                                               0x00 if self.voice_notifications else 0x01,
                                               0x01]))]
            return []

        if code == V2_INIT_REQUEST:
            return [req(bytes([V2_INIT_REPLY, 0x00, 0x03, 0x00, 0x30, 0x32, 0x00, 0x00]))]

        if code == V2_BATTERY_GET:
            return [req(bytes([V2_BATTERY_RET, V2_BATTERY_SINGLE, self.battery,
                               0x01 if self.charging else 0x00]))]

        if code == V2_AUDIO_CODEC_GET:
            return [req(bytes([V2_AUDIO_CODEC_RET, 0x02, 0x10]))]

        if code == FW_VERSION_REQUEST:
            version = b"3.0.0"
            return [req(bytes([FW_VERSION_REPLY, 0x02, len(version)]) + version)]

        if code in (V2_AUDIO_GET, V2_AUDIO_SET):
            return self.audio_reply(code, sub, payload)

        if code in (V2_ASC_GET, V2_ASC_SET):
            if code == V2_ASC_SET and not self.stubborn:
                self.subtype = sub
                if sub == V2_ASC_SUBTYPE_NA:
                    self.mode = 0 if payload[3] == 0x00 else (1 if payload[4] == 0x01 else 2)
                    self.focus = payload[5] == 0x01
                    self.level = payload[6]
                    self.auto_ambient = payload[7] == 0x01
                    self.sensitivity = payload[8]
                else:
                    self.has_wind = len(payload) == 8
                    self.mode = 0 if payload[3] == 0x00 else (1 if payload[4] == 0x01 else 2)
                    self.focus = payload[-2] == 0x01
                    self.level = payload[-1]
            return [req(self.asc())]

        if code == V2_EQ_SET and not self.stubborn:
            if payload[2] == V2_EQ_PRESETS["custom"]:
                count = payload[3]
                self.eq_bands = [payload[4 + i] - V2_EQ_BAND_OFFSET for i in range(count)]
                self.eq_preset = V2_EQ_PRESETS["custom"]
            else:
                self.eq_preset = payload[2]
        if code in (V2_EQ_GET, V2_EQ_SET):
            return [req(self.equalizer())]

        if code in (V2_SYSTEM_GET, V2_SYSTEM_SET):
            if sub == V2_SYSTEM_SUB_SPEAK_TO_CHAT:
                if code == V2_SYSTEM_SET and not self.stubborn:
                    self.speak_to_chat = payload[2] == 0x00
                return [req(bytes([V2_SYSTEM_RET, sub,
                                   0x00 if self.speak_to_chat else 0x01, 0x01]))]
            if sub == V2_SYSTEM_SUB_PAUSE_WHEN_TAKEN_OFF:
                if code == V2_SYSTEM_SET and not self.stubborn:
                    self.pause_when_taken_off = payload[2] == 0x00
                return [req(bytes([V2_SYSTEM_RET, sub,
                                   0x00 if self.pause_when_taken_off else 0x01]))]
            return []

        if code in (V2_APO_GET, V2_APO_SET):
            if sub == V2_APO_SUB_AUTO_POWER_OFF:
                if code == V2_APO_SET and not self.stubborn:
                    self.auto_power_off = payload[2]
                return [req(bytes([V2_APO_RET, sub, self.auto_power_off, 0x00]))]
            return []

        if code in (V2_STC_CONFIG_GET, V2_STC_CONFIG_SET):
            if code == V2_STC_CONFIG_SET and not self.stubborn:
                self.stc = (payload[2], payload[3])
            return [req(bytes([V2_STC_CONFIG_RET, V2_STC_CONFIG_SUB, self.stc[0], self.stc[1]]))]

        return []


class DemoLinkV2(DemoLink):
    """A Link whose other end is a v2 stand-in device."""

    def __init__(self, on_change=None, device=None):
        super().__init__(on_change=on_change)
        self.device = device if device is not None else DemoDeviceV2()
        self.transport = DemoTransport(self.device)
        self._set_protocol("v2")
        self.state["name"] = "WH-1000XM6 (demo)"
        self.state["features"] = features_for("WH-1000XM6", "v2")


# ---------------------------------------------------------------------------
# The daemon
# ---------------------------------------------------------------------------

import select  # noqa: E402  (kept next to the daemon that needs it)


SOCKET_NAME = "omarchy-sony-headphones.sock"
LOCK_NAME = "omarchy-sony-headphones.lock"


def is_private_dir(path: str, *, dir_fd: int | None = None) -> bool:
    """True for a real directory that only this user can reach into.

    lstat, not stat: a symlink pointing at a directory we do own must not pass
    as one. Mode has to be exactly 0700 — group or other bits on the parent are
    enough to let someone else create the socket name before we do.
    """
    try:
        info = os.lstat(path) if dir_fd is None else os.lstat(path, dir_fd=dir_fd)
    except OSError:
        return False
    return (
        stat.S_ISDIR(info.st_mode)
        and info.st_uid == os.getuid()
        and stat.S_IMODE(info.st_mode) == 0o700
    )


def runtime_dir() -> str:
    """The private directory holding the socket and the lock.

    Anything that can write the socket can drive the headphones and read their
    state, so its parent must be a directory nobody else can write. A correct
    XDG_RUNTIME_DIR already is one by definition, but the variable is inherited
    and can point anywhere, so it is checked rather than trusted.

    Without a usable one we make our own and verify it the same way. The old
    fallback was a bare /tmp/user-<uid>, which is a name an attacker on a
    shared machine can create first — as a symlink, or as a directory of their
    own — and then own every file we put in it.
    """
    supplied = os.environ.get("XDG_RUNTIME_DIR")
    if supplied and is_private_dir(supplied):
        return supplied

    fallback = os.path.join(tempfile.gettempdir(), f"omarchy-sony-headphones-{os.getuid()}")
    try:
        os.mkdir(fallback, 0o700)
    except FileExistsError:
        pass
    except OSError as exc:
        raise SystemExit(f"cannot create a private runtime directory at {fallback}: {exc}")

    # Either we just made it, or it was already there — and something we did
    # not make is only usable if it looks exactly like something we would have.
    if not is_private_dir(fallback):
        raise SystemExit(
            f"{fallback} is not a private directory owned by this user; "
            "set XDG_RUNTIME_DIR to a directory you own with mode 0700"
        )
    return fallback


def socket_path() -> str:
    return os.path.join(runtime_dir(), SOCKET_NAME)


# One JSON line on the control socket. State and requests are a few hundred
# bytes; this is far above that and still small enough to hold without care.
MAX_LINE_BYTES = 65536


def emit(payload: dict) -> str:
    """Write one JSON line to stdout, returning it so a fan-out caller can
    encode the same bytes rather than serialise a second time."""
    line = json.dumps(payload) + "\n"
    sys.stdout.write(line)
    sys.stdout.flush()
    return line


def _command_summary(request: dict) -> str:
    """One log-sized description of a request, key and value included.

    The daemon and the no-daemon path both log what they were asked, so the
    summary is built in one place rather than two slightly different ones.
    """
    command = str(request.get("cmd", "status"))
    if command == "set":
        return f"set {request.get('key')}={request.get('value')}"
    return command


# The control-session policy. `hold` keeps the link open as it always has;
# `on-demand` closes it after a quiet spell so the phone app over multipoint
# can take the one control session a Sony headset allows. The widget forwards
# the settings as environment variables, exactly as SONY_HEADPHONES_LOG does.
SESSION_POLICIES = ("hold", "on-demand")
SESSION_POLICY_DEFAULT = "hold"
SESSION_IDLE_DEFAULT = 30
# Bound the quiet spell: zero would release between commands and a huge value
# would never fire, so an out-of-range setting falls back to the default.
SESSION_IDLE_MIN = 1
SESSION_IDLE_MAX = 24 * 60 * 60


def _env_session_policy() -> str:
    setting = os.environ.get("SONY_HEADPHONES_SESSION")
    name = str(setting).strip().lower() if setting is not None else ""
    return name if name in SESSION_POLICIES else SESSION_POLICY_DEFAULT


def _env_session_idle() -> int:
    setting = os.environ.get("SONY_HEADPHONES_SESSION_IDLE")
    if setting is None:
        return SESSION_IDLE_DEFAULT
    try:
        seconds = int(str(setting).strip())
    except (TypeError, ValueError):
        return SESSION_IDLE_DEFAULT
    if not SESSION_IDLE_MIN <= seconds <= SESSION_IDLE_MAX:
        return SESSION_IDLE_DEFAULT
    return seconds


class Daemon:
    """Holds the RFCOMM link open and lends it out over a unix socket.

    Opening RFCOMM costs the better part of a second and the headphones push
    state on their own — press the button on the earcup and a notification
    arrives — so the connection is worth keeping. Short-lived CLI calls talk to
    this process instead of dialling the headphones themselves, and the bar
    widget subscribes for a line of JSON per change.
    """

    POLL_INTERVAL = 60.0
    REQUEST_TIMEOUT = 2.0
    RETRY_MIN = 2.0
    RETRY_MAX = 30.0
    # A link that dies sooner than this never proved itself: something else,
    # a phone on multipoint, is taking the one control session back, so the
    # retry delay has to grow rather than reset to the minimum. A link that
    # held at least this long clears the delay for the next connect.
    STABLE_AFTER = 10.0
    # The web UI is the only intended subscriber, so the cap is generous; it
    # exists to keep the select() watch list and the fd count bounded. A
    # subscription past it is refused rather than evicting an existing client:
    # refusing is simpler and does not surprise a subscriber that was working.
    MAX_SUBSCRIBERS = 16
    # Long enough to drain a healthy socket buffer, short enough that one peer
    # that has stopped reading cannot hold the daemon's only thread for long.
    SUBSCRIBER_TIMEOUT = 1.0

    def __init__(self, preferred: str | None = None, clock=time.monotonic):
        self.preferred = preferred
        self.link: Link | None = None
        self.subscribers: list[socket.socket] = []
        self.retry_delay = self.RETRY_MIN
        self.next_attempt = 0.0
        self.next_poll = 0.0
        # When the current link opened, for the flapping check in lose_link: a
        # link that dies soon after connecting must not reset the retry delay.
        self.connected_since: float | None = None
        self.last_emitted: dict | None = None
        self._lock = None
        self._socket_path = None
        # The injectable clock is for the idle timer and the backoff, so a test
        # can advance time without sleeping; accept()'s request deadline stays
        # on real time.
        self.clock = clock
        # Read once at startup; a change at runtime goes through `session`.
        self.session_policy = _env_session_policy()
        self.session_idle = _env_session_idle()
        # "connecting" still wants the link, so run() keeps retrying; a
        # deliberate "released" is undone only by a command or `reclaim`.
        self.session = "connecting"
        # The demo stand-in is kept across a release/reclaim so a demo write
        # survives the session gap the way a real headset's flash does.
        self.demo_device = None
        self.last_activity: float | None = None
        # A released session keeps the last known values so the panel can still
        # show what the device reported after we hand the transport over.
        self.released_state: dict | None = None
        # The most recent values from a live link, kept across lose_link so a
        # release that arrives after the link died can still hand over the real
        # device name and battery rather than a blank initial_state().
        self.last_values: dict | None = None
        # A link lost while a Background-music write was in flight is explained
        # here, because lose_link rebuilds a blank state that would drop the
        # reason. It clears when the same key is attempted again.
        self.reset_refusal: dict[str, str] = {}

    # -- state out ----------------------------------------------------------

    def state(self) -> dict:
        if self.link is not None:
            state = dict(self.link.state)
        elif self.session == "released" and self.released_state is not None:
            # A released session is disconnected but not blank: hand back the
            # values from just before the release.
            state = dict(self.released_state)
        else:
            state = initial_state()
            state["address"] = self.preferred
        return self._stamp(state)

    def _stamp(self, state: dict) -> dict:
        """Overlay the daemon-owned fields on a link or empty state.

        The link was built with whatever log level and policy were in effect
        then; this process owns the live values, so they are stamped on at the
        boundary whichever state is about to be reported.
        """
        state["logging"] = log_level()
        state["session"] = self.session
        state["session_policy"] = self.session_policy
        state["session_idle"] = self.session_idle
        if self.reset_refusal:
            pending = state.get("pending") or []
            refused = dict(state.get("refused") or {})
            for key, reason in self.reset_refusal.items():
                if key not in pending:
                    refused.setdefault(key, reason)
            state["refused"] = refused
        return state

    def publish(self, state: dict | None = None) -> None:
        state = self._stamp(dict(state if state is not None else self.state()))
        if state == self.last_emitted:
            return
        self.last_emitted = state
        encoded = emit(state).encode()
        for client in list(self.subscribers):
            try:
                client.settimeout(self.SUBSCRIBER_TIMEOUT)
                client.sendall(encoded)
            except (socket.timeout, BlockingIOError, BrokenPipeError, OSError):
                # One client's failure must not abort the fan-out for the rest.
                self.drop(client)

    def drop(self, client: socket.socket) -> None:
        if client in self.subscribers:
            self.subscribers.remove(client)
        try:
            client.close()
        except OSError:
            pass

    # -- device -------------------------------------------------------------

    def try_connect(self) -> None:
        self.next_attempt = self.clock() + self.retry_delay
        self.session = "connecting"
        if demo_mode():
            self.link = demo_link(on_change=self.publish, device=self.demo_device)
            self.link.refresh()
            self.demo_device = getattr(self.link, "device", None)
            self.session = "held"
            # A fresh connection counts as activity: an on-demand session that
            # never receives a command still releases after its quiet spell.
            self.last_activity = self.clock()
            self.connected_since = self.clock()
            LOG.info("connected to %s (demo)", self.link.state.get("name"))
            self.publish()
            return
        device = find_device(self.preferred)
        if device is None:
            self.publish()
            return

        link = Link(device["address"], on_change=self.publish)
        try:
            configure_link(link, device)
            link.refresh()
        except (NotConnected, OSError) as exc:
            link.close()
            state = initial_state()
            state["address"] = device["address"]
            state["name"] = device["name"]
            state["error"] = str(exc)
            self.publish(state)
            self.retry_delay = min(self.RETRY_MAX, self.retry_delay * 2)
            LOG.info("retrying in %.0f seconds", self.retry_delay)
            return

        self.link = link
        self.connected_since = self.clock()
        self.next_poll = self.clock() + self.POLL_INTERVAL
        self.session = "held"
        self.last_activity = self.clock()
        self.publish()

    def lose_link(self, reason: str = "") -> None:
        interrupted = self.link.interrupted_key if self.link is not None else None
        if interrupted in BGM_WRITE_KEYS:
            self.reset_refusal = {interrupted: BGM_RESET_REASON}
        if self.link is not None:
            # Remember what the live link last reported before it is cleared;
            # a later deliberate release falls back to it (see Daemon.release).
            self.last_values = dict(self.link.state)
            self.link.close()
        self.link = None
        # The link died, it was not handed over: keep wanting it back.
        self.session = "connecting"
        state = initial_state()
        state["address"] = self.preferred
        state["error"] = reason or None
        if self.connected_since is not None \
                and self.clock() - self.connected_since >= self.STABLE_AFTER:
            # The link held long enough to prove itself, so the next connect
            # starts from the minimum; a link that died young means something
            # else is taking the one control session back, so back off.
            self.retry_delay = self.RETRY_MIN
        else:
            self.retry_delay = min(self.RETRY_MAX, self.retry_delay * 2)
        self.connected_since = None
        self.next_attempt = self.clock() + self.retry_delay
        LOG.error("link lost: %s", reason or "unknown reason")
        self.publish(state)

    def release(self, reason: str = "") -> None:
        """Hand the one control session back, deliberately.

        A Sony headset allows exactly one control session at a time, so a
        phone paired over multipoint cannot take it while we hold the link.
        Closing the transport returns it; the last known values stay in the
        state so a released panel still shows what the device reported. This
        is a hand-off, not a fault, so no error is set — and the cached channel
        is kept because it is still valid and saves the SDP lookup on reclaim.

        The same path is the one on-demand expiry runs, so a manual release and
        an idle release can never drift apart.
        """
        # `state()` rebuilds a blank initial_state() when there is no live link
        # and nothing released yet — which is the case when lose_link ran first.
        # Fall back to the last values the live link reported so the hand-off
        # still carries the device name and battery.
        state = dict(self.state())
        if self.link is None and self.released_state is None and self.last_values is not None:
            state = dict(self.last_values)
        if self.link is not None:
            self.link.close()
        self.link = None
        self.session = "released"
        self.last_activity = None
        state["connected"] = False
        state["error"] = None
        self.released_state = state
        # A deliberate hand-off, not a fight: the next connect starts fresh.
        self.retry_delay = self.RETRY_MIN
        self.connected_since = None
        LOG.info("session released%s", f": {reason}" if reason else "")
        self.publish(state)

    def reclaim(self) -> None:
        """Take the control session back and refresh it.

        The existing connect path and its backoff rules apply. An already-held
        link is a no-op success, so reclaim is safe to call blindly.
        """
        if self.link is not None:
            self.session = "held"
            # Reclaim is a client command, so it restarts the quiet spell even
            # when there is nothing to reconnect.
            self.last_activity = self.clock()
            return
        self.session = "connecting"
        self.try_connect()
        if self.link is None:
            raise NotConnected("headphones not connected")

    def release_if_idle(self) -> None:
        """Release an on-demand session that has been quiet long enough.

        The timer measures client commands that touched the device, not link
        traffic: the periodic poll and a subscriber reading the state must not
        keep the session alive, or on-demand would never fire. No thread and no
        sleep — this is a timestamp comparison the run loop calls on its tick.
        """
        if self.session_policy != "on-demand" or self.link is None:
            return
        if self.last_activity is None:
            return
        if self.clock() - self.last_activity >= self.session_idle:
            self.release("idle")

    def poll_link(self) -> None:
        """Ask a live link for its periodic liveness answer, when due.

        Kept apart from run() so the poll can be driven without the loop, and
        deliberately does not touch last_activity: silence in answer to a
        question is the only reliable sign a link is gone, so the poll must
        never double as client activity the idle policy would count.
        """
        if self.link is None or demo_mode() or self.clock() < self.next_poll:
            return
        self.next_poll = self.clock() + self.POLL_INTERVAL
        heard = self.link.last_rx
        try:
            self.link.request(self.link.poll_requests(), settle=1.0)
        except (NotConnected, OSError) as exc:
            self.lose_link(str(exc))
        else:
            if self.link is not None and self.link.last_rx == heard:
                self.lose_link("the headphones stopped answering")

    def set_session(self, request: dict) -> None:
        """Apply a runtime `session` change, or raise what the command reports.

        The value arrives over the socket, so both the policy name and the
        idle delay are validated here before they become state (ADR-0004).
        """
        value = request.get("value")
        policy = None
        if value is not None:
            policy = str(value).strip().lower()
            if policy not in SESSION_POLICIES:
                raise ValueError(
                    f"unknown session policy {policy!r}; expected one of "
                    f"{', '.join(SESSION_POLICIES)}"
                )
        idle = request.get("idle")
        seconds = None
        if idle is not None:
            # `idle` crosses the socket, so it must be a whole number: JSON's
            # `true` is a bool (and so an int), and a float would otherwise be
            # truncated silently. Refuse both rather than guess.
            if isinstance(idle, bool) or not isinstance(idle, (int, float)):
                raise ValueError(f"idle seconds must be a whole number, got {idle!r}")
            if isinstance(idle, float) and not idle.is_integer():
                raise ValueError(f"idle seconds must be a whole number, got {idle!r}")
            seconds = int(idle)
            if not SESSION_IDLE_MIN <= seconds <= SESSION_IDLE_MAX:
                raise ValueError(
                    f"idle seconds must be between {SESSION_IDLE_MIN} and {SESSION_IDLE_MAX}"
                )
        # Both fields are valid before either lands, so a rejected request
        # cannot leave half a change behind.
        if policy is not None:
            self.session_policy = policy
        if seconds is not None:
            self.session_idle = seconds
        if (policy is not None or seconds is not None) and self.link is not None:
            # A policy change restarts the quiet spell, so on-demand does not
            # fire off a timestamp from before it was selected.
            self.last_activity = self.clock()

    # -- clients ------------------------------------------------------------

    def with_link(self, action):
        """Run a device action, reconnecting once if the link has gone stale.

        The headphones drop the control session on their own after a while, and
        nothing says so until the next write, so a command that arrives on a
        dead link should repair it rather than report failure at the user. The
        same path reclaims a deliberately released session, so the user never
        has to press reclaim before changing a setting.
        """
        for attempt in (1, 2):
            if self.link is None:
                self.try_connect()
            if self.link is None:
                raise NotConnected("headphones not connected")
            # Only a client command that touches the device feeds the idle
            # timer; a status answered from cache never reaches this point.
            self.last_activity = self.clock()
            try:
                return action(self.link)
            except (NotConnected, OSError) as exc:
                self.lose_link(str(exc))
                if attempt == 2:
                    raise

    def _known_state(self) -> dict | None:
        """The best confirmed state for a pre-check, without opening a link.

        A live link's own state first; otherwise the first of the released
        snapshot and the last live values that carries a confirmed protocol.
        Anything without a protocol is a guess, so it does not count.
        """
        if self.link is not None:
            return self.link.state
        for candidate in (self.released_state, self.last_values):
            if candidate and candidate.get("protocol"):
                return candidate
        return None

    def precheck_setting(self, request: dict) -> str | None:
        """Refuse a set/cycle the confirmed generation cannot carry, if known.

        Runs the pure settings builder against the known state before any link
        is opened, so a key the device cannot carry never costs a connect —
        and never steals the one control session from the phone holding it.
        Returns the refusal message, or None when the command may proceed.
        """
        known = self._known_state()
        if known is None or not known.get("protocol"):
            return None
        builder = setting_requests_v2 if known.get("protocol") == "v2" else setting_requests
        if str(request.get("cmd", "")) == "cycle":
            key, value = "nc", "cycle"
        else:
            key, value = request.get("key", ""), request.get("value")
        try:
            builder(known, key, value)
        except (ValueError, TypeError, ArithmeticError) as exc:
            return str(exc)
        return None

    def handle_command(self, request: dict) -> dict:
        command = str(request.get("cmd", "status"))

        if command == "logging":
            # The level lives in this process; changing it needs no link, so
            # it is handled before anything that would open one.
            value = request.get("value")
            if value is not None:
                configure_logging(str(value))
                LOG.info("logging level set to %s", log_level())
                self.publish()
            return {"ok": True, "state": self.state(), "logging": log_level()}

        if command in ("status", "ping"):
            return {"ok": True, "state": self.state()}

        if command == "release":
            # Manual hand-off of the one control session; see Daemon.release
            # for why this is not an error.
            self.release()
            return {"ok": True, "state": self.state()}

        if command == "reclaim":
            try:
                self.reclaim()
            except (NotConnected, OSError) as exc:
                LOG.error("command failed: reclaim: %s", exc)
                return {"ok": False, "error": str(exc), "state": self.state()}
            LOG.info("command applied: reclaim")
            return {"ok": True, "state": self.state()}

        if command == "session":
            try:
                # A request with neither field is a read: report the policy
                # the daemon is running without touching the link.
                if request.get("value") is not None or request.get("idle") is not None:
                    self.set_session(request)
                    LOG.info(
                        "command applied: session %s idle=%s",
                        self.session_policy, self.session_idle,
                    )
                    self.publish()
            except (ValueError, TypeError, ArithmeticError) as exc:
                LOG.error("command failed: session: %s", exc)
                return {"ok": False, "error": str(exc), "state": self.state()}
            return {"ok": True, "state": self.state()}

        actions = {
            "set": lambda link: apply_setting(link, str(request.get("key", "")), request.get("value")),
            "cycle": lambda link: apply_setting(link, "nc", "cycle"),
            "refresh": lambda link: link.refresh(),
            "power-off": lambda link: link.power_off(),
        }
        action = actions.get(command)
        if action is None:
            LOG.error("unknown command: %s", command)
            return {"ok": False, "error": f"unknown command {command!r}", "state": self.state()}

        if command in ("set", "cycle"):
            # Refuse what the confirmed generation cannot carry before any
            # link is opened, so a bad key never steals the control session.
            message = self.precheck_setting(request)
            if message is not None:
                LOG.error("command failed: %s: %s", _command_summary(request), message)
                return {"ok": False, "error": message, "state": self.state()}

        if command == "set":
            # A fresh attempt supersedes the reset explanation for that key,
            # whether or not the write that follows takes.
            self.reset_refusal.pop(str(request.get("key", "")), None)

        try:
            self.with_link(action)
        except (ValueError, TypeError, ArithmeticError) as exc:
            LOG.error("command failed: %s: %s", _command_summary(request), exc)
            return {"ok": False, "error": str(exc), "state": self.state()}
        except (NotConnected, OSError) as exc:
            LOG.error("command failed: %s: %s", _command_summary(request), exc)
            return {"ok": False, "error": str(exc), "state": self.state()}
        LOG.info("command applied: %s", _command_summary(request))
        return {"ok": True, "state": self.state()}

    def accept(self, listener: socket.socket) -> None:
        try:
            client, _ = listener.accept()
        except OSError:
            return
        # The daemon serves one client at a time, so the deadline covers the
        # whole request: a per-read timeout alone lets a client trickle a byte
        # at a time and hold everything else up for as long as it likes.
        deadline = time.monotonic() + self.REQUEST_TIMEOUT
        # A read or parse failure that is nobody's command (a timeout, a
        # truncated line, unparseable bytes) is still dropped without an
        # answer. Everything after the bytes are in hand goes through the
        # catch-all: a bad command, an absurd number, a genuinely unexpected
        # bug, even a RecursionError from a deeply nested parse, all become a
        # structured refusal, and the daemon carries on to the next client.
        try:
            data = b""
            while b"\n" not in data and len(data) < MAX_LINE_BYTES:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise socket.timeout("the request took too long to arrive")
                client.settimeout(remaining)
                chunk = client.recv(4096)
                if not chunk:
                    break
                data += chunk
            request = json.loads(data.decode() or "{}")

            if not isinstance(request, dict):
                self._reply(client, {
                    "ok": False,
                    "error": "the request must be a JSON object",
                    "state": self.state(),
                })
                return

            if str(request.get("cmd", "")) == "subscribe":
                if len(self.subscribers) >= self.MAX_SUBSCRIBERS:
                    self._reply(client, {
                        "ok": False,
                        "error": "too many subscribers",
                        "state": self.state(),
                    })
                    return
                try:
                    client.settimeout(self.SUBSCRIBER_TIMEOUT)
                    client.sendall((json.dumps(self.state()) + "\n").encode())
                except OSError:
                    self.drop(client)
                    return
                self.subscribers.append(client)
                return

            self._reply(client, self.handle_command(request))
        except (OSError, ValueError):
            self.drop(client)
        except Exception:
            # KeyboardInterrupt and SystemExit are deliberately not caught; an
            # unexpected Exception must not take the daemon down with it.
            LOG.exception("unhandled error handling a request")
            self._reply(client, {
                "ok": False,
                "error": "the helper failed to handle the request",
                "state": self.state(),
            })

    def _reply(self, client: socket.socket, response: dict) -> None:
        """Send one JSON line to a client and hang up."""
        try:
            client.sendall((json.dumps(response) + "\n").encode())
        except OSError:
            pass
        self.drop(client)

    # -- main loop ----------------------------------------------------------

    def listen(self) -> socket.socket:
        """Claim the daemon role, or refuse to start.

        Only one process may hold the Bluetooth link — a second one racing for
        it is how the headphones end up dropping the session — so election runs
        through an exclusive lock rather than the socket file, which two
        processes can both decide is stale and both replace.
        """
        directory = runtime_dir()
        self._socket_path = os.path.join(directory, SOCKET_NAME)
        # Both files are opened relative to a descriptor for the directory that
        # was just verified private, so that is the directory they land in
        # whatever the path resolves to by the time we get there.
        dir_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            self._lock = self.claim_lock(dir_fd)
            listener = self.bind_socket(dir_fd)
        finally:
            os.close(dir_fd)
        listener.listen(8)
        return listener

    def claim_lock(self, dir_fd: int):
        """Open the lock file and take it, or refuse to start."""
        # O_NOFOLLOW: a symlink parked under the name is an error, not a write
        # somewhere else. And no truncation — the lock holds nothing worth
        # clearing, and truncating on open is how a file that turns out to
        # belong to someone else gets damaged before we ever look at it.
        fd = os.open(
            LOCK_NAME,
            os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=dir_fd,
        )
        lock = os.fdopen(fd, "r+")
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            lock.close()
            raise SystemExit(f"{LOCK_NAME} is not a regular file owned by this user")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            lock.close()
            raise SystemExit("another sony-headphones daemon is already running")
        return lock

    def bind_socket(self, dir_fd: int) -> socket.socket:
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        # Bind through the descriptor for the directory that was just verified,
        # not through self._socket_path. /proc/self/fd/<dir_fd> resolves to the
        # inode the descriptor names, so the socket the kernel creates is the
        # one the mode/owner check covered, even if the path was swapped for a
        # symlink between the check and the bind. procfs is present on the only
        # platform this helper runs on, and the path is well under the 108-byte
        # AF_UNIX limit.
        bind_path = f"/proc/self/fd/{dir_fd}/{SOCKET_NAME}"
        # umask rather than a chmod afterwards: bind then creates the socket
        # already unreachable to anyone else, with no window in between.
        previous = os.umask(0o177)
        try:
            try:
                listener.bind(bind_path)
            except OSError as exc:
                if exc.errno != errno.EADDRINUSE:
                    raise
                self.remove_stale_socket(dir_fd)
                listener.bind(bind_path)
        finally:
            os.umask(previous)
        return listener

    def remove_stale_socket(self, dir_fd: int) -> None:
        """Clear a socket left behind by a dead daemon — and nothing else.

        We hold the lock, so anything still on disk under our name is from a
        process that is gone. That reasoning only holds for a socket we own,
        though: unlinking whatever happens to be sitting there is how someone
        else's file, or a symlink to one, becomes ours to delete.
        """
        try:
            info = os.lstat(SOCKET_NAME, dir_fd=dir_fd)
        except FileNotFoundError:
            return
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
            raise SystemExit(
                f"refusing to replace {SOCKET_NAME}: it is not a socket owned by this user"
            )
        os.unlink(SOCKET_NAME, dir_fd=dir_fd)

    def run(self) -> None:
        listener = self.listen()
        try:
            while True:
                now = self.clock()
                # A released session is deliberate: nothing reconnects it until
                # a client command or `reclaim`, or release would undo itself.
                if self.link is None and self.session != "released" and now >= self.next_attempt:
                    self.try_connect()

                watched = [listener] + self.subscribers
                if self.link is not None and self.link.sock is not None:
                    watched.append(self.link.sock)

                try:
                    readable, _, _ = select.select(watched, [], [], 1.0)
                except (OSError, ValueError):
                    readable = []

                for sock in readable:
                    if sock is listener:
                        self.accept(listener)
                    elif sock in self.subscribers:
                        # Subscribers never speak; anything readable is EOF.
                        self.drop(sock)
                    elif self.link is not None and sock is self.link.sock:
                        try:
                            self.link.pump(0.05)
                        except (NotConnected, OSError) as exc:
                            self.lose_link(str(exc))

                self.poll_link()

                # The idle check rides the one-second tick; the poll and a
                # subscriber above are link traffic and must not reset it.
                self.release_if_idle()
        finally:
            if self.link is not None:
                self.link.close()
            listener.close()
            try:
                os.unlink(self._socket_path)
            except OSError:
                pass
            if self._lock is not None:
                self._lock.close()


# ---------------------------------------------------------------------------
# Talking to the daemon
# ---------------------------------------------------------------------------


def daemon_socket(timeout: float = 5.0) -> socket.socket | None:
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    try:
        sock.connect(socket_path())
    except OSError:
        sock.close()
        return None
    return sock


def ask_daemon(request: dict, timeout: float = 10.0) -> dict | None:
    sock = daemon_socket(timeout)
    if sock is None:
        return None
    deadline = time.monotonic() + timeout
    try:
        sock.sendall((json.dumps(request) + "\n").encode())
        data = b""
        while b"\n" not in data:
            if len(data) > MAX_LINE_BYTES:
                return None
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            sock.settimeout(remaining)
            chunk = sock.recv(4096)
            if not chunk:
                break
            data += chunk
        return json.loads(data.decode())
    except (OSError, ValueError):
        return None
    finally:
        sock.close()


def demo_mode() -> str | None:
    """Which command set the demo stands in for, or None when demos are off.

    "1" is the original setting and keeps the v1 stand-in; "v2" and "2" ask
    for the v2 one. Any other truthy value is still a demo, so an old
    SONY_HEADPHONES_DEMO=true behaves exactly as it always did.
    """
    setting = os.environ.get("SONY_HEADPHONES_DEMO", "")
    if setting in ("", "0"):
        return None
    return "v2" if setting in ("v2", "2") else "v1"


def demo_link(on_change=None, device=None) -> Link:
    """A stand-in Link for whichever command set the demo setting names.

    `device` reuses an existing stand-in so its values survive a dropped
    session, the way a real headset's stored settings do.
    """
    if demo_mode() == "v2":
        return DemoLinkV2(on_change=on_change, device=device)
    return DemoLink(on_change=on_change, device=device)


def apply_command(link: Link, request: dict) -> None:
    """Carry out one direct request on a link, demo or hardware alike."""
    command = str(request.get("cmd", "status"))
    if command == "set":
        apply_setting(link, str(request.get("key", "")), request.get("value"))
    elif command == "cycle":
        apply_setting(link, "nc", "cycle")
    elif command == "refresh":
        link.refresh()
    elif command == "power-off":
        link.power_off()


def direct(request: dict, preferred: str | None) -> dict:
    """Do it ourselves, for when no daemon is running."""
    if str(request.get("cmd", "")) in ("logging", "release", "reclaim", "session"):
        # These belong to the daemon's long-running process: the log level and
        # the session policy live there, and a one-shot helper releases its
        # link the moment it exits. Say so rather than report a change that
        # dies with this process, or silently do nothing.
        state = initial_state()
        state["address"] = preferred
        state["error"] = "no sony-headphones daemon is running"
        return {"ok": False, "error": state["error"], "state": state}

    summary = _command_summary(request)
    if demo_mode():
        link = demo_link()
        try:
            link.refresh()
            apply_command(link, request)
            LOG.info("command applied: %s (demo)", summary)
            return {"ok": True, "state": link.state}
        except (ValueError, TypeError, ArithmeticError) as exc:
            LOG.error("command failed: %s: %s", summary, exc)
            return {"ok": False, "error": str(exc), "state": dict(link.state)}

    device = find_device(preferred)
    if device is None:
        state = initial_state()
        state["address"] = preferred
        state["error"] = "no connected Sony headphones found"
        LOG.error("command failed: %s: %s", summary, state["error"])
        return {"ok": False, "error": state["error"], "state": state}

    link = Link(device["address"])
    try:
        configure_link(link, device)
        link.refresh()
        apply_command(link, request)
        LOG.info("command applied: %s", summary)
        # close() below marks the link disconnected, so hand back a snapshot
        # taken while it is still live rather than the dict it mutates.
        return {"ok": True, "state": dict(link.state)}
    except (ValueError, TypeError, ArithmeticError) as exc:
        LOG.error("command failed: %s: %s", summary, exc)
        return {"ok": False, "error": str(exc), "state": dict(link.state)}
    except (NotConnected, OSError) as exc:
        state = dict(link.state)
        state["error"] = str(exc)
        LOG.error("command failed: %s: %s", summary, exc)
        return {"ok": False, "error": str(exc), "state": state}
    finally:
        link.close()


def run_request(request: dict, preferred: str | None) -> dict:
    response = ask_daemon(request)
    if response is None:
        response = direct(request, preferred)
    return response


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def describe(state: dict) -> str:
    if not state.get("connected"):
        return state.get("error") or "Headphones not connected"

    lines = [f"{state.get('name') or state.get('address')}"]

    def add(label, value):
        if value is not None:
            lines.append(f"  {label:<22}{value}")

    battery = state.get("battery")
    if battery is not None:
        add("Battery", f"{battery}%" + (" (charging)" if state.get("charging") else ""))
    add("Firmware", state.get("firmware"))
    add("Codec", state.get("codec"))
    add("Mode", state.get("nc_mode"))
    if state.get("nc_mode") in ("ambient-sound", "off"):
        add("Ambient level", f"{state.get('ambient_level')}/{MAX_AMBIENT_LEVEL}")
        add("Focus on voice", state.get("focus_on_voice"))
    add("Equalizer", state.get("eq_preset"))
    if state.get("eq_bands") is not None:
        # v1 carries a separate clear-bass band; v2's ten bands stand alone.
        prefix = "" if state.get("eq_bass") is None else f"bass {state.get('eq_bass')}, "
        add("Bands", prefix + " ".join(str(b) for b in state["eq_bands"]))
    add("DSEE Extreme", state.get("dsee"))
    add("Connection quality", state.get("connection_quality"))
    add("Listening mode", state.get("listening_mode"))
    if state.get("listening_mode") == "background-music":
        add("  room", state.get("bgm_room_size"))
    add("Speak-to-Chat", state.get("speak_to_chat"))
    if state.get("speak_to_chat"):
        add("  sensitivity", state.get("stc_sensitivity"))
        add("  timeout", state.get("stc_timeout"))
        add("  focus on voice", state.get("stc_focus_on_voice"))
    add("Pause when taken off", state.get("pause_when_taken_off"))
    add("Auto power off", state.get("auto_power_off"))
    add("Touch sensor", state.get("touch_sensor"))
    add("Voice guidance", state.get("voice_notifications"))
    add("NC optimizer", state.get("nc_optimizer_pressure") and f"{state['nc_optimizer_pressure']:.1f} atm")
    devices = state.get("devices")
    if devices:
        peers = []
        for device in devices:
            if device.get("playback"):
                status = "playing"
            elif device.get("connected"):
                status = "connected"
            else:
                status = "disconnected"
            peers.append(f"{device.get('name')} [{status}]")
        add("Multipoint", ", ".join(peers))
    return "\n".join(lines)


def cmd_watch(args) -> int:
    """Stream state changes as JSON lines, one object per line.

    Becomes the daemon if none is running, and otherwise subscribes to the one
    that is, so several bar widgets can watch the same headphones.
    """
    sock = daemon_socket(timeout=5.0)
    if sock is not None:
        try:
            sock.sendall((json.dumps({"cmd": "subscribe"}) + "\n").encode())
            sock.settimeout(None)
            buffered = b""
            while True:
                chunk = sock.recv(4096)
                if not chunk:
                    return 0
                buffered += chunk
                while b"\n" in buffered:
                    line, buffered = buffered.split(b"\n", 1)
                    if line.strip():
                        sys.stdout.write(line.decode() + "\n")
                        sys.stdout.flush()
                # The widget restarts a watcher that exits, so giving up on a
                # line that never ends is safe and better than holding it.
                if len(buffered) > MAX_LINE_BYTES:
                    return 1
        except (OSError, KeyboardInterrupt):
            return 0
        finally:
            sock.close()

    try:
        Daemon(args.address).run()
    except KeyboardInterrupt:
        return 0
    return 0


def cmd_status(args) -> int:
    response = run_request({"cmd": "status"}, args.address)
    state = response.get("state", initial_state())
    if args.json:
        emit(state)
    else:
        print(describe(state))
    return 0 if state.get("connected") else 1


def cmd_set(args) -> int:
    response = run_request({"cmd": "set", "key": args.key, "value": args.value}, args.address)
    return _report(response, args)


def cmd_cycle(args) -> int:
    response = run_request({"cmd": "cycle"}, args.address)
    return _report(response, args)


def cmd_power_off(args) -> int:
    return _report(run_request({"cmd": "power-off"}, args.address), args)


def cmd_release(args) -> int:
    return _report(run_request({"cmd": "release"}, args.address), args)


def cmd_reclaim(args) -> int:
    return _report(run_request({"cmd": "reclaim"}, args.address), args)


def cmd_session(args) -> int:
    """Show or change the daemon's session policy and idle delay."""
    request = {"cmd": "session"}
    if args.value is not None:
        request["value"] = args.value
    if args.idle is not None:
        request["idle"] = args.idle
    response = run_request(request, args.address)
    if args.json:
        emit(_json_state(response))
    elif response.get("ok"):
        state = response.get("state", {})
        print(
            f"Session: {state.get('session', '?')} "
            f"({state.get('session_policy', '?')}, idle {state.get('session_idle', '?')}s)"
        )
    else:
        print(response.get("error", "failed"), file=sys.stderr)
    return 0 if response.get("ok") else 1


def _json_state(response: dict) -> dict:
    """The state to emit for --json, carrying the response's refusal reason.

    The widget reads state.error off every parsed line, so a refusal has to
    ride in the state even though the response keeps its reason in error.
    """
    state = dict(response.get("state", initial_state()))
    if response.get("error"):
        state["error"] = response["error"]
    return state


def cmd_logging(args) -> int:
    """Show or change the log level of the running daemon.

    Without a value the command is a read, which is also the simplest way to
    ask whether a daemon is there at all.
    """
    request = {"cmd": "logging"}
    if args.level is not None:
        request["value"] = args.level
    response = run_request(request, args.address)
    if args.json:
        emit(_json_state(response))
    elif response.get("ok"):
        print(f"Logging: {response.get('logging', '?')}")
    else:
        print(response.get("error", "failed"), file=sys.stderr)
    return 0 if response.get("ok") else 1


def _report(response: dict, args) -> int:
    state = response.get("state", initial_state())
    if args.json:
        emit(_json_state(response))
    elif response.get("ok"):
        print(describe(state))
    else:
        print(response.get("error", "failed"), file=sys.stderr)
    return 0 if response.get("ok") else 1


def cmd_probe(args) -> int:
    """Diagnostics worth pasting into a bug report."""
    print(f"bluetoothctl:      {'found' if bluetoothctl('--version') else 'MISSING'}")
    # Diagnostics want the machine as it is now, not a two-second-old list:
    # bypass the cache so a bug report shows a live scan.
    devices = connected_devices(live=True)
    if not devices:
        print("Sony devices:      none connected")
        print("\nPair and connect the headphones first, then run this again.")
        return 1
    for device in devices:
        print(f"Sony device:       {device['name']} [{device['address']}] ({device.get('protocol') or '?'})")
        print(f"  cached channel:  {cached_channel(device['address']) or '-'}")

    device = next(
        (d for d in devices if args.address and d["address"].lower() == args.address.lower()),
        devices[0],
    )
    link = Link(device["address"])
    started = time.monotonic()
    try:
        channel = configure_link(link, device)
    except (NotConnected, OSError) as exc:
        print(f"  connect:         FAILED ({exc})")
        return 1
    print(f"  connect:         ok on RFCOMM channel {channel} "
          f"({link.protocol or '?'}) in {time.monotonic() - started:.2f}s")
    try:
        link.refresh()
        print()
        print(describe(link.state))
    finally:
        link.close()
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sony-headphones",
        description=(
            "Control Sony headphones over Bluetooth. Speaks protocol v1 "
            "(WH-1000XM2/XM3/XM4) and v2 (WH-1000XM5/XM6, WF-1000XM5, LinkBuds, CH720N…)."
        ),
    )
    parser.add_argument("--address", help="Bluetooth MAC to use, if several are connected")
    parser.add_argument("--json", action="store_true", help="print the device state as JSON")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("status", help="show the current state").set_defaults(func=cmd_status)
    sub.add_parser("watch", help="stream state changes as JSON lines").set_defaults(func=cmd_watch)
    sub.add_parser("cycle", help="cycle noise cancelling / ambient / off").set_defaults(func=cmd_cycle)
    sub.add_parser("probe", help="diagnose the connection").set_defaults(func=cmd_probe)
    sub.add_parser("power-off", help="turn the headphones off").set_defaults(func=cmd_power_off)
    sub.add_parser("release", help="release the control session").set_defaults(func=cmd_release)
    sub.add_parser("reclaim", help="reconnect and hold the control session").set_defaults(func=cmd_reclaim)

    session = sub.add_parser("session", help="show or change the session policy")
    session.add_argument("value", nargs="?", choices=SESSION_POLICIES,
                         help="hold or on-demand")
    session.add_argument("--idle", type=int, metavar="SECONDS",
                         help="quiet seconds before an on-demand session is released")
    session.set_defaults(func=cmd_session)

    logger = sub.add_parser("logging", help="show or change the local log level")
    logger.add_argument("level", nargs="?", choices=tuple(LOG_LEVELS),
                        help="off, errors or all")
    logger.set_defaults(func=cmd_logging)

    setter = sub.add_parser("set", help="change one setting")
    setter.add_argument("key", choices=SETTING_KEYS, metavar="KEY", help=", ".join(SETTING_KEYS))
    setter.add_argument("value")
    setter.set_defaults(func=cmd_set)

    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        args = parser.parse_args(["status", *argv])
    configure_logging()
    try:
        return args.func(args)
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 130
    except Exception:
        # An exception this far up is a bug, and it still has to leave a
        # trail; the re-raise keeps the process's exit behaviour unchanged.
        LOG.exception("unhandled error")
        raise


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
